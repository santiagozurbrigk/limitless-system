{
  "regions": [
    "gru1"
  ],
  "headers": [
    {
      "source": "/api/integrations/(.*)/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/integrations/(.*)/oauth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/integrations/google/thumbnail",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/integrations/fathom/process",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/integrations/fathom/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/integrations/typeform/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/integrations/google-forms/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/calendly-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ghl-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/integrations/instagram/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/integrations/instagram/poll",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/mercadopago-token-refresh",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/intelligence-snapshot",
      "schedule": "0 0,12 * * *"
    },
    {
      "path": "/api/cron/founder-tone-analysis",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/executive-report-daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/executive-report-weekly",
