      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/cleanup-trial-reels",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/capture-ad-metrics",
      "schedule": "30 5 * * *"
