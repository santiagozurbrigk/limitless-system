+export async function atenderIngestaDeLanding(
+  request: Request,
+  dependencias: DependenciasDeIngesta,
+): Promise<Response> {
+  let admin: SupabaseClient;
+  try {
+    admin = (dependencias.cliente ?? createAdminClient)();
+  } catch (error) {
+    console.error(`${ETIQUETA} No se pudo crear el cliente de la base.`);
+    reportarFalla(error, { provider: "landing" });
+    return respuesta(500, ERROR_INTERNO);
+  }
+
+  // 1. Clave.
+  let clave: Awaited<ReturnType<typeof verificarClaveDeIngesta>>;
+  try {
+    clave = await verificarClaveDeIngesta(tokenDelPedido(request), {
+      cliente: admin,
+      enSegundoPlano: dependencias.enSegundoPlano,
+    });
+  } catch (error) {
+    // `verificarClaveDeIngesta` lanza con un texto fijo, sin la clave ni el hash.
+    console.error(`${ETIQUETA} No se pudo verificar la clave de ingesta.`);
+    reportarFalla(error, { provider: "landing" });
+    return respuesta(500, ERROR_INTERNO);
+  }
+  if (!clave) return respuesta(401, NO_AUTORIZADO);
+  const { organizationId } = clave;
+
+  // 2. Límite por clave.
+  const limite = await (dependencias.limite ?? landingIngestRateLimit)(
+    `ingest-landing:${clave.claveId}`,
+  );
+  if (!limite.allowed) return demasiadasSolicitudes(limite.resetAt);
+
+  // 3. Cuerpo.
+  const cuerpo = await leerCuerpoConLimite(request, LIMITE_DEL_CUERPO_BYTES);
+  if (cuerpo.tipo === "grande") return respuesta(413, CUERPO_DEMASIADO_GRANDE);
+  if (cuerpo.tipo === "ilegible") return respuesta(400, PAYLOAD_INVALIDO);
+
+  // 4. JSON y contrato.
+  let json: unknown;
+  try {
+    json = JSON.parse(cuerpo.texto);
+  } catch {
+    return respuesta(400, PAYLOAD_INVALIDO);
+  }
+  const evento = validarEventoDeLanding(json, { referencia: new Date() });
+  if (!evento) return respuesta(400, PAYLOAD_INVALIDO);
+
+  // 5. Crudo primero: tal cual llegó.
+  let crudo: EventoCrudo;
+  try {
+    crudo = await guardarEventoCrudo(admin, organizationId, evento.type, json);
+  } catch (error) {
+    console.error(`${ETIQUETA} No se pudo guardar el evento crudo.`, { organizationId });
+    reportarFalla(error, { organizationId, provider: "landing" });
+    return respuesta(500, ERROR_INTERNO);
+  }
+
+  // 6. Normalizar después de responder. `procesarEventoCrudo` no lanza.
+  dependencias.enSegundoPlano(async () => {
+    const resultado = await procesarEventoCrudo(admin, crudo);
+    if (resultado.status === "error" || resultado.status === "sin_cerrar") {
+      // Sin Sentry: el cron lo reprocesa y avisa si falla 5 veces.
+      console.warn(`${ETIQUETA} La normalización no terminó; queda para el reproceso.`, {
+        organizationId,
+        eventoId: crudo.id,
+        estado: resultado.status,
+      });
+    }
+  });
+
+  return NextResponse.json(RESPUESTA_OK, { status: 200 });
+}
diff --git a/apps/web/lib/webinar/identity.ts b/apps/web/lib/webinar/identity.ts
new file mode 100644
index 00000000..e9227330
--- /dev/null
+++ b/apps/web/lib/webinar/identity.ts
@@ -0,0 +1,68 @@
+/**
+ * Identidad del lead de Limitless Webinars (SCRUM-528).
+ *
+ * La persona es la unidad de dato (P8): un lead por organización y email
+ * normalizado (`leads_org_email_normalized_key`). Este módulo decide cuándo
+ * dos registros son la misma persona y cómo se guarda su teléfono. Es puro:
+ * no lee la base ni el reloj.
+ *
+ * El email y el teléfono son datos personales: nada de acá los manda a un log
+ * ni a Sentry, y quien llama tampoco tiene que hacerlo.
+ */
+
+/** Largos que acepta la base (checks de `leads`). */
+export const LARGO_MINIMO_DEL_EMAIL = 3;
+export const LARGO_MAXIMO_DEL_EMAIL = 320;
+
+/** Una arroba, algo antes, y un dominio con al menos un punto. */
+const FORMA_DE_EMAIL = /^[^@]+@[^@]+\.[^@]+$/;
+
+/**
+ * Caracteres invisibles que deja un copiar y pegar y `\s` no cubre: espacio,
+ * unión y no unión de ancho cero, unión de palabras, separador vocal mongol y
+ * BOM.
+ */
+const INVISIBLES = /[\u200B-\u200D\u2060\u180E\uFEFF]/g;
+
+/**
+ * Email normalizado: en Unicode NFC (una "é" compuesta y una "e" con tilde
+ * combinada son la misma), sin caracteres invisibles de ancho cero, sin
+ * ningún espacio (ni al principio, ni al final, ni en el medio, donde lo deja
+ * un autocompletado) y en minúsculas. Es lo que va a
+ * `leads.email_normalized` y la llave del lead.
+ */
+export function normalizarEmail(email: string): string {
+  return email.replace(INVISIBLES, "").replace(/\s+/g, "").toLowerCase().normalize("NFC");
+}
+
+/** Si el email, ya normalizado, tiene forma de email y el largo que acepta la base. */
+export function esEmailValido(email: string): boolean {
+  const normalizado = normalizarEmail(email);
+  return (
+    normalizado.length >= LARGO_MINIMO_DEL_EMAIL &&
+    normalizado.length <= LARGO_MAXIMO_DEL_EMAIL &&
+    FORMA_DE_EMAIL.test(normalizado)
+  );
+}
+
+/** E.164: `+`, un primer dígito de 1 a 9 y en total de 7 a 15 dígitos (check de `leads.phone_e164`). */
+const FORMA_E164 = /^\+[1-9][0-9]{6,14}$/;
+
+/** Separadores habituales de un teléfono escrito a mano. */
+const SEPARADORES = /[\s().\-/]/g;
+
+/**
+ * El teléfono en E.164 si se puede saber sin adivinar; si no, `null`.
+ *
+ * Sólo se convierte un número que ya trae el código de país, con `+` o con el
+ * prefijo internacional `00`. Uno sin código de país (`11 5555 1234`) queda
+ * en `null`: completarlo con un país sería inventar un dato, y la landing
+ * puede recibir gente de cualquier país. No hay una dependencia para esto a
+ * propósito (la regla de SCRUM-528 es no sumar dependencias).
+ */
+export function telefonoE164(telefono: string | null | undefined): string | null {
+  if (typeof telefono !== "string") return null;
+  let limpio = telefono.trim().replace(SEPARADORES, "");
+  if (limpio.startsWith("00")) limpio = `+${limpio.slice(2)}`;
+  return FORMA_E164.test(limpio) ? limpio : null;
+}
diff --git a/apps/web/lib/webinar/ingesta-landing.ts b/apps/web/lib/webinar/ingesta-landing.ts
new file mode 100644
index 00000000..3d82e33e
--- /dev/null
+++ b/apps/web/lib/webinar/ingesta-landing.ts
@@ -0,0 +1,356 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { FallaDeLaBase } from "@/lib/server/action-result";
+import { normalizarEmail } from "@/lib/webinar/identity";
+import { validarEventoDeLanding, type EventoDeLanding } from "@/lib/webinar/normalize/evento";
+import {
+  datosQueCompletan,
+  filaDeLaVisita,
+  filaDelEventoRegistrado,
+  filaDelLead,
+  filaDelRegistro,
+  motivoParaNoAsignar,
+  MOTIVO_PAYLOAD_FUERA_DE_CONTRATO,
+  NOTA_ID_REUSADO_CON_OTRO_EMAIL,
+  type LanzamientoLeido,
+  type RegistroGuardado,
+} from "@/lib/webinar/normalize/filas";
+import { mensajeDeFalla, type PasoDeNormalizacion } from "@/lib/webinar/normalize/reproceso";
+
+/**
+ * Ingesta de la landing de Limitless Webinars (SCRUM-528): guardar el crudo y
+ * normalizarlo. Crudo primero (P2): el endpoint guarda el evento tal cual
+ * llegó en `landing_events` y responde; la normalización corre después, fuera
+ * del camino de la respuesta, y si falla el crudo queda y lo reprocesa el cron.
+ *
+ * Todas las consultas filtran (o escriben) `organization_id`: el que sale de
+ * la clave de ingesta. El cliente es el admin (service role, sin RLS), así que
+ * ese filtro es lo único que separa una organización de otra.
+ *
+ * Nada de acá manda a un log o a Sentry datos personales: los errores llevan
+ * el paso y el SQLSTATE, nunca el texto de la base (que puede repetir valores
+ * de la fila).
+ */
+
+/** Unique violation: la fila ya estaba (reenvío o reproceso). */
+const YA_EXISTE = "23505";
+
+export type EventoCrudo = {
+  id: string;
+  organization_id: string;
+  kind: string;
+  payload: unknown;
+  received_at: string;
+};
+
+const COLUMNAS_DEL_CRUDO = "id, organization_id, kind, payload, received_at";
+
+/**
+ * Guarda el evento crudo en `pending`. Si la base falla, lanza `FallaDeLaBase`
+ * con un texto fijo: el endpoint responde 500 y la landing reintenta.
+ */
+export async function guardarEventoCrudo(
+  admin: SupabaseClient,
+  organizationId: string,
+  tipo: EventoDeLanding["type"],
+  payload: unknown,
+): Promise<EventoCrudo> {
+  const { data, error } = await admin
+    .from("landing_events")
+    .insert({ organization_id: organizationId, kind: tipo, payload, status: "pending" })
+    .select(COLUMNAS_DEL_CRUDO)
+    .single();
+  if (error || !data) {
+    throw new FallaDeLaBase({
+      message: "No se pudo guardar el evento crudo de la landing.",
+      code: (error as { code?: string | null } | null)?.code ?? null,
+    });
+  }
+  return data as EventoCrudo;
+}
+
+/** Falla de la base en un paso de la normalización: lleva el paso y el SQLSTATE, nada más. */
+export class FallaDeNormalizacion extends Error {
+  constructor(
+    readonly paso: PasoDeNormalizacion,
+    readonly codigo: string | null,
+  ) {
+    super(mensajeDeFalla(paso, codigo));
+    this.name = "FallaDeNormalizacion";
+  }
+}
+
+function fallo(paso: PasoDeNormalizacion, error: unknown): FallaDeNormalizacion {
+  const codigo = (error as { code?: unknown } | null)?.code;
+  return new FallaDeNormalizacion(paso, typeof codigo === "string" ? codigo : null);
+}
+
+export type ResultadoDeNormalizacion =
+  /** `nota`: texto fijo que queda en `error_message` de un `processed` (rastreable). */
+  | { estado: "processed"; nota?: string }
+  | { estado: "unmapped"; motivo: string };
+
+
+/**
+ * ⭐ Normaliza un evento guardado: escribe el lead, el registro y su evento
+ * `registered`, o la visita. No toca el estado del crudo (eso es
+ * `cerrarEventoCrudo`). Si la base falla en un paso, lanza
+ * `FallaDeNormalizacion`.
+ *
+ * Idempotente: se puede correr dos veces sobre el mismo evento (reenvío de la
+ * landing o reproceso) sin duplicar nada. Cada escritura tiene su llave única
+ * y un 23505 quiere decir "ya estaba"; el registro se queda con el primero.
+ */
+export async function normalizarEventoCrudo(
+  admin: SupabaseClient,
+  crudo: EventoCrudo,
+): Promise<ResultadoDeNormalizacion> {
+  // La ventana de occurred_at se mide contra received_at: la misma decisión en
+  // el intento del endpoint y en cualquier reproceso.
+  const evento = validarEventoDeLanding(crudo.payload, { referencia: new Date(crudo.received_at) });
+  if (!evento) return { estado: "unmapped", motivo: MOTIVO_PAYLOAD_FUERA_DE_CONTRATO };
+
+  const organizationId = crudo.organization_id;
+  const { data: lanzamiento, error: errorLanzamiento } = await admin
+    .from("webinar_launches")
+    .select("id, status")
+    .eq("organization_id", organizationId)
+    .eq("public_id", evento.launch_public_id)
+    .maybeSingle();
+  if (errorLanzamiento) throw fallo("lanzamiento", errorLanzamiento);
+
+  const motivo = motivoParaNoAsignar(lanzamiento as LanzamientoLeido | null);
+  if (motivo) return { estado: "unmapped", motivo };
+  const launchId = (lanzamiento as LanzamientoLeido).id;
+
+  if (evento.type === "visit") {
+    const { error } = await admin
+      .from("landing_visits")
+      .insert(filaDeLaVisita(evento, { organizationId, launchId, recibidoEn: crudo.received_at }));
+    if (error && error.code !== YA_EXISTE) throw fallo("visita", error);
+    return { estado: "processed" };
+  }
+
+  // Si el client_registration_id ya está registrado con otro email, no se
+  // crea un lead suelto: se conserva el primer registro (AR pasada 1).
+  const previo = await registroPorId(admin, organizationId, evento.client_registration_id);
+  if (previo && !(await esDelMismoEmail(admin, organizationId, previo.lead_id, evento.email))) {
+    await asegurarEventoRegistrado(admin, previo);
+    return { estado: "processed", nota: NOTA_ID_REUSADO_CON_OTRO_EMAIL };
+  }
+
+  const leadId = await asegurarLead(admin, evento, organizationId, crudo.received_at);
+
+  const { error: errorRegistro } = await admin.from("launch_registrations").insert(
+    filaDelRegistro(evento, {
+      organizationId,
+      launchId,
+      leadId,
+      eventoCrudoId: crudo.id,
+      recibidoEn: crudo.received_at,
+    }),
+  );
+  if (errorRegistro && errorRegistro.code !== YA_EXISTE) throw fallo("registro", errorRegistro);
+
+  const guardado = await registroGuardado(
+    admin,
+    organizationId,
+    evento.client_registration_id,
+    launchId,
+    leadId,
+  );
+
+  await asegurarEventoRegistrado(admin, guardado);
+  return { estado: "processed" };
+}
+
+/** El evento `registered` del registro guardado; si ya estaba, nada. */
+async function asegurarEventoRegistrado(
+  admin: SupabaseClient,
+  guardado: RegistroGuardado,
+): Promise<void> {
+  const { error } = await admin.from("lead_events").insert(filaDelEventoRegistrado(guardado));
+  if (error && error.code !== YA_EXISTE) throw fallo("evento", error);
+}
+
+/** El registro de este `client_registration_id` en la organización, si existe. */
+async function registroPorId(
+  admin: SupabaseClient,
+  organizationId: string,
+  clientRegistrationId: string,
+): Promise<RegistroGuardado | null> {
+  const { data, error } = await admin
+    .from("launch_registrations")
+    .select(COLUMNAS_DEL_REGISTRO)
+    .eq("organization_id", organizationId)
+    .eq("client_registration_id", clientRegistrationId)
+    .maybeSingle();
+  if (error) throw fallo("registro", error);
+  return (data as RegistroGuardado | null) ?? null;
+}
+
+/** Si el lead del registro previo tiene el mismo email normalizado que el que llega. */
+async function esDelMismoEmail(
+  admin: SupabaseClient,
+  organizationId: string,
+  leadId: string,
+  email: string,
+): Promise<boolean> {
+  const { data, error } = await admin
+    .from("leads")
+    .select("email_normalized")
+    .eq("organization_id", organizationId)
+    .eq("id", leadId)
+    .maybeSingle();
+  if (error) throw fallo("lead", error);
+  return (data as { email_normalized: string } | null)?.email_normalized === normalizarEmail(email);
+}
+
+/**
+ * El id del lead de este email en la organización, creándolo si no existe
+ * (`insert ... on conflict (organization_id, email_normalized) do nothing`).
+ * Si ya existía, sólo se completan el nombre o el teléfono que le faltaban.
+ */
+async function asegurarLead(
+  admin: SupabaseClient,
+  evento: Extract<EventoDeLanding, { type: "registration" }>,
+  organizationId: string,
+  recibidoEn: string,
+): Promise<string> {
+  const fila = filaDelLead(evento, organizationId, recibidoEn);
+  const { data: creados, error } = await admin
+    .from("leads")
+    .upsert(fila, { onConflict: "organization_id,email_normalized", ignoreDuplicates: true })
+    .select("id");
+  if (error) throw fallo("lead", error);
+  const creado = (creados as Array<{ id: string }> | null)?.[0];
+  if (creado) return creado.id;
+
+  const { data: existente, error: errorLectura } = await admin
+    .from("leads")
+    .select("id, name, phone_e164")
+    .eq("organization_id", organizationId)
+    .eq("email_normalized", fila.email_normalized)
+    .maybeSingle();
+  if (errorLectura || !existente) throw fallo("lead", errorLectura);
+
+  const lead = existente as { id: string; name: string | null; phone_e164: string | null };
+  const cambios = datosQueCompletan(lead, fila);
+  if (Object.keys(cambios).length > 0) {
+    const { error: errorCambio } = await admin
+      .from("leads")
+      .update(cambios)
+      .eq("organization_id", organizationId)
+      .eq("id", lead.id);
+    if (errorCambio) throw fallo("lead", errorCambio);
+  }
+  return lead.id;
+}
+
+const COLUMNAS_DEL_REGISTRO =
+  "organization_id, launch_id, lead_id, client_registration_id, registered_at";
+
+/**
+ * El registro que quedó: el de este `client_registration_id` (un reenvío) o,
+ * si no hay, el del lead en este lanzamiento con otro id (se queda el primero).
+ */
+async function registroGuardado(
+  admin: SupabaseClient,
+  organizationId: string,
+  clientRegistrationId: string,
+  launchId: string,
+  leadId: string,
+): Promise<RegistroGuardado> {
+  const porId = await registroPorId(admin, organizationId, clientRegistrationId);
+  if (porId) return porId;
+
+  const porLead = await admin
+    .from("launch_registrations")
+    .select(COLUMNAS_DEL_REGISTRO)
+    .eq("organization_id", organizationId)
+    .eq("launch_id", launchId)
+    .eq("lead_id", leadId)
+    .maybeSingle();
+  if (porLead.error || !porLead.data) throw fallo("registro", porLead.error);
+  return porLead.data as RegistroGuardado;
+}
+
+export type CierreDelEvento =
+  | { status: "processed"; nota?: string }
+  | { status: "unmapped"; motivo: string }
+  /** `failed`: error definitivo, después del último reproceso. */
+  | { status: "error" | "failed"; mensaje: string };
+
+/**
+ * Deja el crudo en su estado final, sólo si sigue en `pending` (el que lo
+ * reclamó es quien lo cierra). Todos llevan `processed_at`; `unmapped`,
+ * `error` y `failed` llevan su motivo en `error_message` (texto fijo), y un
+ * `processed`, la nota si la hay. Devuelve si
+ * se cerró; si la base falla, `false`: el evento queda en `pending` y el cron
+ * lo levanta como trabado.
+ */
+export async function cerrarEventoCrudo(
+  admin: SupabaseClient,
+  crudo: Pick<EventoCrudo, "id" | "organization_id">,
+  cierre: CierreDelEvento,
+  ahora: Date = new Date(),
+): Promise<boolean> {
+  const texto =
+    cierre.status === "processed"
+      ? (cierre.nota ?? null)
+      : cierre.status === "unmapped"
+        ? cierre.motivo
+        : cierre.mensaje;
+  const cambios = { status: cierre.status, error_message: texto, processed_at: ahora.toISOString() };
+  try {
+    const { data, error } = await admin
+      .from("landing_events")
+      .update(cambios)
+      .eq("organization_id", crudo.organization_id)
+      .eq("id", crudo.id)
+      .eq("status", "pending")
+      .select("id")
+      .maybeSingle();
+    return !error && Boolean(data);
+  } catch {
+    return false;
+  }
+}
+
+export type ResultadoDeProceso =
+  | { status: "processed" }
+  | { status: "unmapped" }
+  | { status: "error" | "failed"; paso: PasoDeNormalizacion; codigo: string | null }
+  /** Normalizó (o no) pero no pudo escribir el estado final. */
+  | { status: "sin_cerrar" };
+
+/**
+ * Normaliza y cierra el crudo. Con `ultimoIntento`, una falla lo deja en
+ * `failed` (error definitivo) en vez de `error`. No lanza nunca: corre en
+ * `after` o en el cron, donde una excepción no tiene quién la atienda.
+ */
+export async function procesarEventoCrudo(
+  admin: SupabaseClient,
+  crudo: EventoCrudo,
+  opciones: { ultimoIntento?: boolean } = {},
+): Promise<ResultadoDeProceso> {
+  let cierre: CierreDelEvento;
+  let resultado: ResultadoDeProceso;
+  try {
+    const normalizado = await normalizarEventoCrudo(admin, crudo);
+    if (normalizado.estado === "processed") {
+      cierre = { status: "processed", nota: normalizado.nota };
+      resultado = { status: "processed" };
+    } else {
+      cierre = { status: "unmapped", motivo: normalizado.motivo };
+      resultado = { status: "unmapped" };
+    }
+  } catch (error) {
+    const paso = error instanceof FallaDeNormalizacion ? error.paso : "desconocido";
+    const codigo = error instanceof FallaDeNormalizacion ? error.codigo : null;
+    const status = opciones.ultimoIntento ? "failed" : "error";
+    cierre = { status, mensaje: mensajeDeFalla(paso, codigo) };
+    resultado = { status, paso, codigo };
+  }
+  const cerrado = await cerrarEventoCrudo(admin, crudo, cierre);
+  return cerrado ? resultado : { status: "sin_cerrar" };
+}
diff --git a/apps/web/lib/webinar/normalize/evento.ts b/apps/web/lib/webinar/normalize/evento.ts
new file mode 100644
index 00000000..269e617c
--- /dev/null
+++ b/apps/web/lib/webinar/normalize/evento.ts
@@ -0,0 +1,174 @@
+import { z } from "zod";
+import { esEmailValido } from "@/lib/webinar/identity";
+
+/**
+ * El contrato de lo que manda la landing a `POST /api/ingest/landing`
+ * (SCRUM-528, sección 5.1 de los requerimientos técnicos).
+ *
+ * ```json
+ * { "type": "registration" | "visit", "launch_public_id", "client_registration_id",
+ *   "name", "email", "phone",
+ *   "tracking": { "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "fbclid", "sl" },
+ *   "ab_variant", "qualification", "visitor_id", "occurred_at" }
+ * ```
+ *
+ * Campos requeridos según el tipo:
+ *   - `registration`: `launch_public_id`, `client_registration_id` y `email`.
+ *   - `visit`: `launch_public_id` y `visitor_id`.
+ * El resto es opcional y puede venir en `null`. Las claves que no están en el
+ * contrato se ignoran para normalizar, pero el crudo las guarda (por eso pasan
+ * por el mismo control de texto que el resto). `occurred_at`, si viene, es
+ * una fecha ISO 8601 con zona. Se usa sólo si cae dentro de la ventana de
+ * `VENTANA_HACIA_ATRAS_MS` y `VENTANA_HACIA_ADELANTE_MS` alrededor de la hora
+ * en que llegó; fuera de ella (un reloj de navegador adelantado, un año 0 o
+ * 10000 que no entra en un `timestamptz`, un 1900 que movería las métricas)
+ * se ignora y vale la hora en que llegó, igual que si no viniera (AR pasada
+ * 2: rechazarlo perdía el registro). El crudo guarda el valor original.
+ *
+ * Qué se rechaza antes de guardar nada (el endpoint responde 400), para que lo
+ * que pasa se pueda guardar siempre como jsonb y normalizar (AR pasada 1):
+ *   - cualquier texto, valor o clave, con NUL (`\u0000`, jsonb no lo acepta) o
+ *     con un surrogate suelto (no es UTF-16 bien formado; Postgres lo rechaza);
+ *   - estructuras de más de `PROFUNDIDAD_MAXIMA` niveles (`JSON.stringify` de
+ *     supabase-js revienta con miles);
+ *   - textos más largos que lo que acepta su columna;
+ *   - lo que no cumple el contrato (un `occurred_at` que no es una fecha ISO
+ *     con zona, por ejemplo). Un `occurred_at` bien escrito pero fuera de la
+ *     ventana NO se rechaza: se ignora (ver arriba).
+ */
+
+/** Cuerpo máximo que acepta el endpoint: 16 KB. */
+export const LIMITE_DEL_CUERPO_BYTES = 16 * 1024;
+
+/** Niveles de objetos y arrays que se aceptan (el contrato usa 2). */
+export const PROFUNDIDAD_MAXIMA = 10;
+
+/** `occurred_at` puede ser hasta 30 días anterior a la llegada... */
+export const VENTANA_HACIA_ATRAS_MS = 30 * 24 * 60 * 60 * 1000;
+/** ...y hasta 5 minutos posterior (relojes desfasados de la landing). */
+export const VENTANA_HACIA_ADELANTE_MS = 5 * 60 * 1000;
+
+/** Un surrogate alto sin bajo detrás, o uno bajo sin alto delante. */
+const SURROGATE_SUELTO = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
+
+/**
+ * Si el texto se puede guardar en Postgres: sin NUL y UTF-16 bien formado
+ * (lo mismo que `String.prototype.isWellFormed`, que el `lib` ES2022 del
+ * proyecto no tipa).
+ */
+export function esTextoGuardable(texto: string): boolean {
+  return !texto.includes("\u0000") && !SURROGATE_SUELTO.test(texto);
+}
+
+/**
+ * Recorre el JSON ya parseado con profundidad acotada: todo texto (valor o
+ * clave, también las de más) tiene que ser guardable y nada puede pasar de
+ * `PROFUNDIDAD_MAXIMA` niveles. Corta en el primer problema.
+ */
+export function esJsonGuardable(valor: unknown, nivel: number = 0): boolean {
+  if (typeof valor === "string") return esTextoGuardable(valor);
+  if (valor === null || typeof valor !== "object") return true;
+  if (nivel >= PROFUNDIDAD_MAXIMA) return false;
+  if (Array.isArray(valor)) return valor.every((item) => esJsonGuardable(item, nivel + 1));
+  return Object.entries(valor).every(
+    ([clave, item]) => esTextoGuardable(clave) && esJsonGuardable(item, nivel + 1),
+  );
+}
+
+/** Si `occurred_at` cae dentro de la ventana alrededor de `referencia`. */
+export function estaEnLaVentana(occurredAt: string, referencia: Date): boolean {
+  const momento = Date.parse(occurredAt);
+  if (Number.isNaN(momento)) return false;
+  const base = referencia.getTime();
+  return (
+    momento >= base - VENTANA_HACIA_ATRAS_MS &&
+    momento <= base + VENTANA_HACIA_ADELANTE_MS
+  );
+}
+
+/** Texto obligatorio: sin espacios a los costados, de 1 a `maximo` caracteres. */
+const obligatorio = (maximo: number) => z.string().trim().min(1).max(maximo);
+
+/** Texto opcional: vacío o sólo espacios vale lo mismo que no mandarlo. */
+const opcional = (maximo: number) =>
+  z
+    .string()
+    .trim()
+    .max(maximo)
+    .nullish()
+    .transform((valor) => (valor ? valor : null));
+
+const tracking = z
+  .object({
+    utm_source: opcional(500),
+    utm_medium: opcional(500),
+    utm_campaign: opcional(500),
+    utm_content: opcional(500),
+    utm_term: opcional(500),
+    fbclid: opcional(1000),
+    sl: opcional(500),
+  })
+  .nullish()
+  .transform((valor) => valor ?? null);
+
+const comunes = {
+  launch_public_id: obligatorio(100),
+  occurred_at: z.iso
+    .datetime({ offset: true })
+    .nullish()
+    .transform((valor) => valor ?? null),
+};
+
+const registro = z.object({
+  type: z.literal("registration"),
+  ...comunes,
+  client_registration_id: obligatorio(200),
+  email: z.string().trim().max(320).refine(esEmailValido),
+  name: opcional(200),
+  phone: opcional(40),
+  tracking,
+  ab_variant: opcional(200),
+  qualification: opcional(500),
+});
+
+const visita = z.object({
+  type: z.literal("visit"),
+  ...comunes,
+  visitor_id: obligatorio(200),
+});
+
+export const esquemaDelEventoDeLanding = z.discriminatedUnion("type", [registro, visita]);
+
+export type EventoDeLanding = z.output<typeof esquemaDelEventoDeLanding>;
+export type RegistroDeLanding = Extract<EventoDeLanding, { type: "registration" }>;
+export type VisitaDeLanding = Extract<EventoDeLanding, { type: "visit" }>;
+
+export type OpcionesDeValidacion = {
+  /**
+   * Contra qué hora se mide la ventana de `occurred_at`: la de llegada. La
+   * normalización pasa `received_at`, así la decisión es la misma en el
+   * intento del endpoint y en cualquier reproceso.
+   */
+  referencia: Date;
+};
+
+/**
+ * El evento validado, o `null` si no se puede guardar o no cumple el
+ * contrato. Un `occurred_at` fuera de la ventana vuelve en `null` (se usa la
+ * hora de llegada). No devuelve el motivo a propósito: los mensajes de Zod
+ * repiten valores del payload (datos personales), y la respuesta del
+ * endpoint es un motivo genérico.
+ */
+export function validarEventoDeLanding(
+  json: unknown,
+  opciones: OpcionesDeValidacion,
+): EventoDeLanding | null {
+  if (!esJsonGuardable(json)) return null;
+  const resultado = esquemaDelEventoDeLanding.safeParse(json);
+  if (!resultado.success) return null;
+  const { occurred_at } = resultado.data;
+  if (occurred_at !== null && !estaEnLaVentana(occurred_at, opciones.referencia)) {
+    return { ...resultado.data, occurred_at: null };
+  }
+  return resultado.data;
+}
diff --git a/apps/web/lib/webinar/normalize/filas.ts b/apps/web/lib/webinar/normalize/filas.ts
new file mode 100644
index 00000000..4e0cfd3e
--- /dev/null
+++ b/apps/web/lib/webinar/normalize/filas.ts
@@ -0,0 +1,196 @@
+import { normalizarEmail, telefonoE164 } from "@/lib/webinar/identity";
+import type { RegistroDeLanding, VisitaDeLanding } from "./evento";
+
+/**
+ * De un evento de la landing ya validado a las filas que se escriben
+ * (SCRUM-528). Puro: no lee la base ni el reloj; la hora en que llegó el
+ * evento la pasa quien llama.
+ */
+
+/** Cuándo pasó: lo que dice la landing, o la hora en que llegó si no lo dice. */
+export function momentoDelEvento(
+  evento: { occurred_at: string | null },
+  recibidoEn: string,
+): string {
+  return new Date(evento.occurred_at ?? recibidoEn).toISOString();
+}
+
+/**
+ * El día de una visita, en UTC (`YYYY-MM-DD`). Es parte de la llave
+ * `(launch_id, visitor_id, day)`: tiene que dar lo mismo en cualquier servidor
+ * y con cualquier `TZ`, así que no usa la zona local.
+ */
+export function diaUtc(momento: string): string {
+  return new Date(momento).toISOString().slice(0, 10);
+}
+
+export type LanzamientoLeido = { id: string; status: string };
+
+export const MOTIVO_LANZAMIENTO_DESCONOCIDO =
+  "Lanzamiento desconocido: el launch_public_id no es de un lanzamiento de esta organización.";
+export const MOTIVO_LANZAMIENTO_CERRADO = "Lanzamiento cerrado: no recibe registros ni visitas.";
+export const MOTIVO_PAYLOAD_FUERA_DE_CONTRATO =
+  "El payload guardado no cumple el contrato de la landing.";
+/**
+ * Nota de un `processed` cuyo `client_registration_id` ya estaba registrado
+ * con otro email (la persona corrigió el email y la landing reusó el id): se
+ * conserva el primer registro y no se crea un lead suelto. Rastreable por el
+ * texto, sin datos personales.
+ */
+export const NOTA_ID_REUSADO_CON_OTRO_EMAIL =
+  "client_registration_id ya registrado con otro email: se conservó el primer registro y no se creó otro lead.";
+
+/**
+ * Por qué un evento no se puede asignar a su lanzamiento, o `null` si se
+ * puede. Desconocido (no existe en la organización de la clave) o cerrado:
+ * el evento queda `unmapped` con este motivo, sin descartarlo. Un borrador
+ * (`draft`) sí recibe: es como se prueba la landing antes de abrir.
+ */
+export function motivoParaNoAsignar(lanzamiento: LanzamientoLeido | null): string | null {
+  if (!lanzamiento) return MOTIVO_LANZAMIENTO_DESCONOCIDO;
+  if (lanzamiento.status === "closed") return MOTIVO_LANZAMIENTO_CERRADO;
+  return null;
+}
+
+export type FilaDeLead = {
+  organization_id: string;
+  email: string;
+  email_normalized: string;
+  name: string | null;
+  phone_e164: string | null;
+  first_seen_at: string;
+};
+
+export function filaDelLead(
+  evento: RegistroDeLanding,
+  organizationId: string,
+  recibidoEn: string,
+): FilaDeLead {
+  return {
+    organization_id: organizationId,
+    email: evento.email,
+    email_normalized: normalizarEmail(evento.email),
+    name: evento.name,
+    phone_e164: telefonoE164(evento.phone),
+    first_seen_at: momentoDelEvento(evento, recibidoEn),
+  };
+}
+
+/**
+ * Qué datos le faltan a un lead que ya existía y trae este registro. El lead
+ * se queda con lo primero que se supo de él; un registro posterior sólo
+ * completa lo que estaba vacío (nunca pisa un nombre ni un teléfono).
+ */
+export function datosQueCompletan(
+  existente: { name: string | null; phone_e164: string | null },
+  nuevo: Pick<FilaDeLead, "name" | "phone_e164">,
+): Partial<Pick<FilaDeLead, "name" | "phone_e164">> {
+  const cambios: Partial<Pick<FilaDeLead, "name" | "phone_e164">> = {};
+  if (!existente.name && nuevo.name) cambios.name = nuevo.name;
+  if (!existente.phone_e164 && nuevo.phone_e164) cambios.phone_e164 = nuevo.phone_e164;
+  return cambios;
+}
+
+export type FilaDeRegistro = {
+  organization_id: string;
+  launch_id: string;
+  lead_id: string;
+  client_registration_id: string;
+  registered_at: string;
+  utm_source: string | null;
+  utm_medium: string | null;
+  utm_campaign: string | null;
+  utm_content: string | null;
+  utm_term: string | null;
+  fbclid: string | null;
+  sl: string | null;
+  ab_variant: string | null;
+  qualification: string | null;
+  raw_event_id: string;
+};
+
+export function filaDelRegistro(
+  evento: RegistroDeLanding,
+  contexto: {
+    organizationId: string;
+    launchId: string;
+    leadId: string;
+    eventoCrudoId: string;
+    recibidoEn: string;
+  },
+): FilaDeRegistro {
+  const t = evento.tracking;
+  return {
+    organization_id: contexto.organizationId,
+    launch_id: contexto.launchId,
+    lead_id: contexto.leadId,
+    client_registration_id: evento.client_registration_id,
+    registered_at: momentoDelEvento(evento, contexto.recibidoEn),
+    utm_source: t?.utm_source ?? null,
+    utm_medium: t?.utm_medium ?? null,
+    utm_campaign: t?.utm_campaign ?? null,
+    utm_content: t?.utm_content ?? null,
+    utm_term: t?.utm_term ?? null,
+    fbclid: t?.fbclid ?? null,
+    sl: t?.sl ?? null,
+    ab_variant: evento.ab_variant,
+    qualification: evento.qualification,
+    raw_event_id: contexto.eventoCrudoId,
+  };
+}
+
+/** El registro que quedó en la base (el primero), del que sale el evento `registered`. */
+export type RegistroGuardado = {
+  organization_id: string;
+  launch_id: string;
+  lead_id: string;
+  client_registration_id: string;
+  registered_at: string;
+};
+
+export type FilaDeEventoDelLead = {
+  organization_id: string;
+  lead_id: string;
+  launch_id: string;
+  kind: "registered";
+  occurred_at: string;
+  source: "landing";
+  source_ref: string;
+};
+
+/**
+ * El evento `registered` sale del registro guardado, no del que acaba de
+ * llegar: si el lead ya estaba registrado en el lanzamiento con otro
+ * `client_registration_id`, el evento es el de aquel registro y la llave
+ * `(organization_id, source, source_ref, kind)` no deja un segundo.
+ */
+export function filaDelEventoRegistrado(registro: RegistroGuardado): FilaDeEventoDelLead {
+  return {
+    organization_id: registro.organization_id,
+    lead_id: registro.lead_id,
+    launch_id: registro.launch_id,
+    kind: "registered",
+    occurred_at: registro.registered_at,
+    source: "landing",
+    source_ref: registro.client_registration_id,
+  };
+}
+
+export type FilaDeVisita = {
+  organization_id: string;
+  launch_id: string;
+  visitor_id: string;
+  day: string;
+};
+
+export function filaDeLaVisita(
+  evento: VisitaDeLanding,
+  contexto: { organizationId: string; launchId: string; recibidoEn: string },
+): FilaDeVisita {
+  return {
+    organization_id: contexto.organizationId,
+    launch_id: contexto.launchId,
+    visitor_id: evento.visitor_id,
+    day: diaUtc(momentoDelEvento(evento, contexto.recibidoEn)),
+  };
+}
diff --git a/apps/web/lib/webinar/normalize/reproceso.ts b/apps/web/lib/webinar/normalize/reproceso.ts
new file mode 100644
index 00000000..a3fd0e7a
--- /dev/null
+++ b/apps/web/lib/webinar/normalize/reproceso.ts
@@ -0,0 +1,45 @@
+/**
+ * Textos de `landing_events.error_message` y el tope de reprocesos
+ * (SCRUM-528). Puro.
+ *
+ * Desde la AR pasada 1 el estado del reproceso vive en columnas propias
+ * (migración `20261016130000_landing_events_reprocesos`):
+ *   - `reprocess_attempts`: cuántos reprocesos arrancó el cron (el intento del
+ *     endpoint no cuenta). Se suma al reclamar, así un proceso que se corta a
+ *     la mitad igual gasta su intento;
+ *   - `status = 'failed'`: el error definitivo, después del reproceso número
+ *     `MAXIMO_DE_REPROCESOS`. El cron no lo lee nunca.
+ * `error_message` es sólo un texto fijo que describe la última falla (el paso
+ * y el SQLSTATE), el motivo de un `unmapped` o la nota de un `processed`.
+ * Nunca datos personales ni el texto de la base, y nada lo interpreta.
+ */
+
+/** Cuántas veces reprocesa el cron un evento que falló (además del intento del endpoint). */
+export const MAXIMO_DE_REPROCESOS = 5;
+
+/** Paso de la normalización que falló. Va en el texto del error, nunca un dato. */
+export type PasoDeNormalizacion =
+  | "lanzamiento"
+  | "lead"
+  | "registro"
+  | "evento"
+  | "visita"
+  /** Una excepción que no vino de una consulta (por ejemplo, la red caída). */
+  | "desconocido";
+
+/** Sólo un SQLSTATE (5 caracteres) o un código de PostgREST: nada más entra al texto. */
+const FORMA_DE_CODIGO = /^(?:[0-9A-Z]{5}|PGRST\d{3})$/;
+
+export function codigoSeguro(codigo: unknown): string | null {
+  return typeof codigo === "string" && FORMA_DE_CODIGO.test(codigo) ? codigo : null;
+}
+
+/** El texto de una falla de normalización: el paso y, si es seguro, el código. */
+export function mensajeDeFalla(paso: PasoDeNormalizacion, codigo: string | null): string {
+  const conCodigo = codigoSeguro(codigo);
+  return `Falló la normalización en ${paso}${conCodigo ? ` (código ${conCodigo})` : ""}.`;
+}
+
+/** Un evento cuyo último reproceso se cortó sin cerrarse: pasa a `failed` sin procesarlo otra vez. */
+export const MENSAJE_REPROCESO_SIN_TERMINAR =
+  "El último reproceso no terminó y no quedan reprocesos.";
diff --git a/apps/web/lib/webinar/reprocesar-landing.ts b/apps/web/lib/webinar/reprocesar-landing.ts
new file mode 100644
index 00000000..4bc9a206
--- /dev/null
+++ b/apps/web/lib/webinar/reprocesar-landing.ts
@@ -0,0 +1,210 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { reportarFalla } from "@/lib/observability/reportar-falla";
+import { limiteDePendienteTrabado } from "@/lib/webhooks/reclamar";
+import { procesarEventoCrudo, type EventoCrudo } from "@/lib/webinar/ingesta-landing";
+import {
+  codigoSeguro,
+  MAXIMO_DE_REPROCESOS,
+  MENSAJE_REPROCESO_SIN_TERMINAR,
+} from "@/lib/webinar/normalize/reproceso";
+
+/**
+ * Reproceso de los eventos de la landing (SCRUM-528), con el patrón de
+ * `lib/webhooks/reclamar.ts`: lo corre el cron `/api/cron/reprocesar-landing`
+ * cada 10 minutos.
+ *
+ * Toma los eventos en `error` y los trabados en `pending` (llegaron hace más
+ * de `MINUTOS_PENDIENTE_TRABADO` y nadie los cerró: la función se cortó antes
+ * o durante la normalización), filtrando por columnas (condición exacta sobre
+ * el índice `landing_events_status_received`). Cada uno se reclama con un UPDATE
+ * condicionado a lo que se leyó (estado, `reprocess_attempts` y, en un
+ * `pending`, la marca `processed_at`) que suma uno a `reprocess_attempts`: dos
+ * corridas a la vez no lo procesan dos veces ni cuentan mal.
+ *
+ * Hasta `MAXIMO_DE_REPROCESOS` reprocesos por evento. Si el último falla (o
+ * se cortó sin cerrarse), el evento pasa a `failed`, el error definitivo que
+ * el cron ya no lee, y se avisa a Sentry (sin datos personales: el id del
+ * evento, la organización, el paso y el SQLSTATE). Para revivirlo, ver
+ * `docs/operacion/alertas.md`.
+ *
+ * `unmapped` no se reprocesa: un lanzamiento desconocido o cerrado no cambia
+ * por reintentar.
+ */
+
+export const RUTA_DEL_CRON_DE_REPROCESO = "/api/cron/reprocesar-landing";
+
+/** Cuántos eventos toma por corrida, como mucho. */
+export const EVENTOS_POR_CORRIDA = 200;
+
+type Candidato = EventoCrudo & {
+  status: "error" | "pending";
+  processed_at: string | null;
+  reprocess_attempts: number;
+};
+
+const COLUMNAS =
+  "id, organization_id, kind, payload, received_at, status, processed_at, reprocess_attempts";
+
+export type ResumenDeReproceso = {
+  encontrados: number;
+  procesados: number;
+  sinAsignar: number;
+  conError: number;
+  /** Los que fallaron su último reproceso y no se reintentan más. */
+  definitivos: number;
+  /** Otro proceso los tomó entre la lectura y el reclamo, o no se pudieron cerrar. */
+  omitidos: number;
+};
+
+export type OpcionesDeReproceso = {
+  limite?: number;
+  ahora?: Date;
+};
+
+/** Los candidatos, de todas las organizaciones (es el cron), del más viejo al más nuevo. */
+async function leerCandidatos(
+  admin: SupabaseClient,
+  limite: number,
+  ahora: Date,
+): Promise<Candidato[]> {
+  const trabadoAntesDe = limiteDePendienteTrabado(ahora);
+  const [fallidos, trabados] = await Promise.all([
+    admin
+      .from("landing_events")
+      .select(COLUMNAS)
+      .eq("status", "error")
+      .order("received_at", { ascending: true })
+      .limit(limite),
+    admin
+      .from("landing_events")
+      .select(COLUMNAS)
+      .eq("status", "pending")
+      .lt("received_at", trabadoAntesDe)
+      .order("received_at", { ascending: true })
+      .limit(limite),
+  ]);
+  const error = fallidos.error ?? trabados.error;
+  if (error) {
+    throw new Error(
+      `No se pudieron leer los eventos de la landing para reprocesar (código ${codigoSeguro(error.code) ?? "sin código"}).`,
+    );
+  }
+  return ([...(fallidos.data ?? []), ...(trabados.data ?? [])] as Candidato[])
+    .sort((a, b) => a.received_at.localeCompare(b.received_at))
+    .slice(0, limite);
+}
+
+/**
+ * UPDATE condicionado a lo que se leyó. Devuelve si lo tomó esta corrida.
+ * Un `pending` sólo se toma si su marca `processed_at` es vieja o no tiene,
+ * igual que en `reclamarEvento`.
+ */
+async function reclamar(
+  admin: SupabaseClient,
+  candidato: Candidato,
+  cambios: Record<string, unknown>,
+  ahora: Date,
+): Promise<boolean> {
+  const limite = limiteDePendienteTrabado(ahora);
+  let consulta = admin
+    .from("landing_events")
+    .update(cambios)
+    .eq("organization_id", candidato.organization_id)
+    .eq("id", candidato.id)
+    .eq("status", candidato.status)
+    .eq("reprocess_attempts", candidato.reprocess_attempts);
+  if (candidato.status === "pending") {
+    if (candidato.processed_at !== null && candidato.processed_at >= limite) return false;
+    consulta = consulta.lt("received_at", limite);
+    consulta =
+      candidato.processed_at === null
+        ? consulta.is("processed_at", null)
+        : consulta.lt("processed_at", limite);
+  }
+  const { data, error } = await consulta.select("id").maybeSingle();
+  return !error && Boolean(data);
+}
+
+function avisarErrorDefinitivo(
+  candidato: Candidato,
+  detalle: { paso?: string; codigo?: string | null },
+): void {
+  console.error("[reprocesar-landing] Un evento de la landing quedó en error definitivo.", {
+    organizationId: candidato.organization_id,
+    eventoId: candidato.id,
+  });
+  reportarFalla(
+    new Error(
+      `Un evento de la landing falló sus ${MAXIMO_DE_REPROCESOS} reprocesos y quedó en error definitivo.`,
+    ),
+    {
+      cron: RUTA_DEL_CRON_DE_REPROCESO,
+      organizationId: candidato.organization_id,
+      provider: "landing",
+      extra: { landing_event_id: candidato.id, paso: detalle.paso ?? null, codigo: codigoSeguro(detalle.codigo) },
+    },
+  );
+}
+
+export async function reprocesarEventosDeLanding(
+  admin: SupabaseClient,
+  opciones: OpcionesDeReproceso = {},
+): Promise<ResumenDeReproceso> {
+  const ahora = opciones.ahora ?? new Date();
+  const candidatos = await leerCandidatos(admin, opciones.limite ?? EVENTOS_POR_CORRIDA, ahora);
+  const resumen: ResumenDeReproceso = {
+    encontrados: candidatos.length,
+    procesados: 0,
+    sinAsignar: 0,
+    conError: 0,
+    definitivos: 0,
+    omitidos: 0,
+  };
+
+  for (const candidato of candidatos) {
+    const hechos = candidato.reprocess_attempts;
+
+    // Ya agotó sus reprocesos (se cortó en el último sin cerrarse): definitivo sin procesar.
+    if (hechos >= MAXIMO_DE_REPROCESOS) {
+      const tomado = await reclamar(
+        admin,
+        candidato,
+        { status: "failed", error_message: MENSAJE_REPROCESO_SIN_TERMINAR, processed_at: ahora.toISOString() },
+        ahora,
+      );
+      if (tomado) {
+        resumen.definitivos++;
+        avisarErrorDefinitivo(candidato, {});
+      } else {
+        resumen.omitidos++;
+      }
+      continue;
+    }
+
+    const reproceso = hechos + 1;
+    const tomado = await reclamar(
+      admin,
+      candidato,
+      { status: "pending", reprocess_attempts: reproceso, processed_at: ahora.toISOString() },
+      ahora,
+    );
+    if (!tomado) {
+      resumen.omitidos++;
+      continue;
+    }
+
+    const resultado = await procesarEventoCrudo(admin, candidato, {
+      ultimoIntento: reproceso >= MAXIMO_DE_REPROCESOS,
+    });
+    if (resultado.status === "processed") resumen.procesados++;
+    else if (resultado.status === "unmapped") resumen.sinAsignar++;
+    else if (resultado.status === "sin_cerrar") resumen.omitidos++;
+    else if (resultado.status === "failed") {
+      resumen.definitivos++;
+      avisarErrorDefinitivo(candidato, { paso: resultado.paso, codigo: resultado.codigo });
+    } else {
+      resumen.conError++;
+    }
+  }
+  return resumen;
+}
