diff --git a/apps/web/lib/auth/destino-despues-del-login.ts b/apps/web/lib/auth/destino-despues-del-login.ts
new file mode 100644
index 00000000..6bfbe9da
--- /dev/null
+++ b/apps/web/lib/auth/destino-despues-del-login.ts
@@ -0,0 +1,25 @@
+/**
+ * Adónde va alguien que entra sin un destino pedido: el login con contraseña
+ * (`postAuthRedirect` en `app/auth/actions.ts`) y `/auth/callback` sin `next`
+ * usan esta misma resolución (fix-pack 1 de A1, MNR-1: el callback no tenía la rama
+ * del holding y un holding `webinar` terminaba en Equipo).
+ *
+ *   - Una cuenta holding: a su holding (`/holding`), sea cual sea la
+ *     experiencia.
+ *   - El resto: la pantalla de inicio de la experiencia de la organización
+ *     activa (`/dashboard` para `full`; la primera entrada lista del menú que
+ *     la persona ve para `webinar` y `limitless`, SCRUM-524).
+ *
+ * El super admin, el cambio de contraseña obligatorio y las invitaciones se
+ * deciden antes, en cada llamador.
+ */
+import "server-only";
+import { loadProfileOrganizationContext } from "@/lib/auth/bootstrap";
+import { pantallaDeInicioDeLaOrganizacionActiva } from "@/lib/organization/ruta-de-la-experiencia";
+import { paths } from "@/routes";
+
+export async function destinoPorDefectoDespuesDelLogin(userId: string): Promise<string> {
+  const { accountType } = await loadProfileOrganizationContext(userId);
+  if (accountType === "holding") return paths.platform.holding;
+  return pantallaDeInicioDeLaOrganizacionActiva();
+}
diff --git a/apps/web/lib/navigation/__tests__/menu-por-experiencia.test.ts b/apps/web/lib/navigation/__tests__/menu-por-experiencia.test.ts
new file mode 100644
index 00000000..f35720c0
--- /dev/null
+++ b/apps/web/lib/navigation/__tests__/menu-por-experiencia.test.ts
@@ -0,0 +1,203 @@
+import { describe, expect, it } from "vitest";
+import { buildPlatformSidebarNav } from "@/lib/navigation/sidebar-modules";
+import type { SidebarNavConfig, SidebarNavRootItem } from "@/lib/navigation/sidebar-nav-config";
+import { emptyPermissions, type PermissionModuleId } from "@/constants/permission-modules";
+import { canSeeNavItem } from "@/providers/permissions-provider";
+import { itemsDeLaPaleta } from "@/components/navigation/command-palette";
+import { platformNavigation } from "@/routes/navigation";
+import type { PermissionLevel } from "@/types/team";
+
+/**
+ * SCRUM-524 · La barra y la paleta de comandos según la experiencia (full,
+ * webinar y limitless).
+ *
+ * La barra filtra los items del config con `canSeeNavItem` (notch nav y menú
+ * móvil); acá se aplica la misma regla al config que arma
+ * `buildPlatformSidebarNav`. La paleta usa `itemsDeLaPaleta`, el mismo que
+ * llama el componente.
+ */
+
+type Permisos = { isFounder: boolean; modules: Record<PermissionModuleId, PermissionLevel> };
+
+const FOUNDER: Permisos = { isFounder: true, modules: emptyPermissions() };
+const MIEMBRO_CON_EQUIPO: Permisos = {
+  isFounder: false,
+  modules: { ...emptyPermissions(), team: "view", finance: "full" },
+};
+const MIEMBRO_SIN_EQUIPO: Permisos = {
+  isFounder: false,
+  modules: { ...emptyPermissions(), finance: "full", sales: "full" },
+};
+
+function describir(item: SidebarNavRootItem): string {
+  if (item.type === "divider") return "—";
+  if (item.type === "parent") return `[${item.key}]`;
+  return item.module.href;
+}
+
+/** Lo que dibuja la barra: los links y grupos que el permiso deja ver. */
+function visibles(config: SidebarNavConfig, permisos: Permisos): string[] {
+  const acceso = (m: PermissionModuleId) =>
+    permisos.isFounder || (permisos.modules[m] ?? "none") !== "none";
+  const out: string[] = [];
+  for (const item of config.rootItems) {
+    if (item.type === "link") {
+      if (!item.module.disabled && canSeeNavItem(item.module.permissionId, acceso, permisos.isFounder)) {
+        out.push(item.module.label);
+      }
+    } else if (item.type === "parent") {
+      const hijos = config.modulesWithChildren[item.key]?.children.filter(
+        (c) => !c.hidden && canSeeNavItem(c.permissionId, acceso, permisos.isFounder)
+      );
+      if (hijos?.length) out.push(config.modulesWithChildren[item.key]!.label);
+    }
+  }
+  return out;
+}
+
+describe("⭐ barra de una organización full: igual que antes", () => {
+  it("sin experiencia o con full, el mismo config", () => {
+    for (const addOns of [[], ["operaciones", "producto"]] as const) {
+      expect(buildPlatformSidebarNav([...addOns], "full")).toEqual(buildPlatformSidebarNav([...addOns]));
+    }
+  });
+
+  it("los items de siempre, en el orden de siempre", () => {
+    expect(buildPlatformSidebarNav([], "full").rootItems.map(describir)).toEqual([
+      "/dashboard",
+      "/clients",
+      "/team",
+      "—",
+      "[marketing]",
+      "[ventas]",
+      "[finanzas]",
+      "/funnels",
+      "—",
+      "/workboard",
+      "/operations/sops",
+      "[configuracion]",
+    ]);
+    expect(buildPlatformSidebarNav(["operaciones", "producto"], "full").rootItems.map(describir)).toContain(
+      "[operaciones]"
+    );
+  });
+
+  it("un founder ve todos los módulos", () => {
+    expect(visibles(buildPlatformSidebarNav([], "full"), FOUNDER)).toEqual([
+      "Panel General",
+      "Clientes",
+      "Equipo",
+      "Marketing",
+      "Ventas",
+      "Finanzas",
+      "Embudos",
+      "Tablero de trabajo",
+      "SOPs",
+      "Configuración",
+    ]);
+  });
+});
+
+describe("⭐ barra de una organización webinar", () => {
+  const webinar = buildPlatformSidebarNav(["operaciones", "producto"], "webinar");
+
+  it("sólo las entradas listas del menú (hoy, Equipo), aunque tenga add-ons", () => {
+    expect(webinar.rootItems.map(describir)).toEqual(["/team"]);
+  });
+
+  it("cada entrada lleva su módulo de permisos", () => {
+    const [equipo] = webinar.rootItems;
+    expect(equipo).toMatchObject({ type: "link", module: { label: "Equipo", permissionId: "team" } });
+  });
+
+  it("sin grupos: ni Configuración ni Integraciones en la isla derecha", () => {
+    expect(webinar.modulesWithChildren).toEqual({});
+    expect(webinar.getParentFromPath("/finance")).toBeNull();
+  });
+
+  it("además, filtrada por los permisos de siempre", () => {
+    expect(visibles(webinar, FOUNDER)).toEqual(["Equipo"]);
+    expect(visibles(webinar, MIEMBRO_CON_EQUIPO)).toEqual(["Equipo"]);
+    expect(visibles(webinar, MIEMBRO_SIN_EQUIPO)).toEqual([]);
+  });
+});
+
+describe("⭐ barra de una organización limitless", () => {
+  const limitless = buildPlatformSidebarNav(["operaciones", "producto"], "limitless");
+  const SOLO_VENTAS: Permisos = { isFounder: false, modules: { ...emptyPermissions(), sales: "view" } };
+
+  it("Clientes, Tablero de trabajo, el grupo Ventas y Equipo, en ese orden, aunque tenga add-ons; Administración no", () => {
+    expect(limitless.rootItems.map(describir)).toEqual(["/clients", "/workboard", "[ventas]", "/team"]);
+  });
+
+  it("⭐ los mismos items que el menú completo: links con su módulo y el grupo Ventas con sus hijos", () => {
+    const completo = buildPlatformSidebarNav([], "full");
+    const linkDe = (config: SidebarNavConfig, href: string) =>
+      config.rootItems.find((i) => i.type === "link" && i.module.href === href);
+    for (const href of ["/clients", "/workboard", "/team"]) {
+      expect(linkDe(limitless, href)).toEqual(linkDe(completo, href));
+    }
+    expect(limitless.modulesWithChildren).toEqual({ ventas: completo.modulesWithChildren.ventas });
+  });
+
+  it("Ventas se marca activo en sus rutas y nada más; sin Configuración ni Integraciones", () => {
+    expect(limitless.getParentFromPath("/sales/inbox")).toBe("ventas");
+    expect(limitless.getParentFromPath("/sales")).toBe("ventas");
+    expect(limitless.getParentFromPath("/salesforce")).toBeNull();
+    expect(limitless.getParentFromPath("/clients")).toBeNull();
+    expect(limitless.getParentFromPath("/settings")).toBeNull();
+    expect(limitless.modulesWithChildren.configuracion).toBeUndefined();
+  });
+
+  it("además, filtrada por los permisos de siempre", () => {
+    expect(visibles(limitless, FOUNDER)).toEqual(["Clientes", "Tablero de trabajo", "Ventas", "Equipo"]);
+    expect(visibles(limitless, SOLO_VENTAS)).toEqual(["Ventas"]);
+    expect(visibles(limitless, MIEMBRO_CON_EQUIPO)).toEqual(["Equipo"]);
+  });
+});
+
+describe("⭐ paleta de comandos", () => {
+  it("full: lo de siempre, sin importar los permisos (las acciones rápidas y todo el menú)", () => {
+    const founder = itemsDeLaPaleta("full", FOUNDER);
+    expect(itemsDeLaPaleta("full", MIEMBRO_SIN_EQUIPO)).toEqual(founder);
+    const labels = founder.map((i) => i.label);
+    expect(labels).toEqual(
+      expect.arrayContaining(["Enviar input semanal", "Crear SOP", "Bandeja de ventas", "Panel General"])
+    );
+    const delMenu = platformNavigation.flatMap((i) =>
+      i.children?.length ? i.children.map((c) => c.href) : [i.href]
+    );
+    expect(founder.slice(4).map((i) => i.href)).toEqual(delMenu);
+  });
+
+  it("webinar: sólo las entradas listas, filtradas por permiso, sin acciones rápidas", () => {
+    expect(itemsDeLaPaleta("webinar", FOUNDER)).toEqual([
+      { label: "Equipo", href: "/team", group: "Plataforma", keywords: "Equipo" },
+    ]);
+    expect(itemsDeLaPaleta("webinar", MIEMBRO_CON_EQUIPO).map((i) => i.href)).toEqual(["/team"]);
+    expect(itemsDeLaPaleta("webinar", MIEMBRO_SIN_EQUIPO)).toEqual([]);
+  });
+
+  it("⭐ limitless: Clientes, Tablero, los hijos de Ventas y Equipo, filtrados por permiso, sin acciones rápidas", () => {
+    expect(itemsDeLaPaleta("limitless", FOUNDER).map((i) => `${i.group}: ${i.label} ${i.href}`)).toEqual([
+      "Plataforma: Clientes /clients",
+      "Plataforma: Tablero de trabajo /workboard",
+      "Ventas: Bandeja /sales/inbox",
+      "Ventas: Métricas /sales/metrics",
+      "Ventas: Closing /sales/closing",
+      "Ventas: Cobros /sales/cobros",
+      "Ventas: Llamadas /sales/llamadas",
+      "Plataforma: Equipo /team",
+    ]);
+    expect(itemsDeLaPaleta("limitless", MIEMBRO_SIN_EQUIPO).map((i) => i.href)).toEqual([
+      "/sales/inbox",
+      "/sales/metrics",
+      "/sales/closing",
+      "/sales/cobros",
+      "/sales/llamadas",
+    ]);
+    expect(itemsDeLaPaleta("limitless", MIEMBRO_CON_EQUIPO)).toEqual([
+      { label: "Equipo", href: "/team", group: "Plataforma", keywords: "Equipo" },
+    ]);
+  });
+});
diff --git a/apps/web/lib/navigation/__tests__/rutas-por-experiencia-en-disco.test.ts b/apps/web/lib/navigation/__tests__/rutas-por-experiencia-en-disco.test.ts
new file mode 100644
index 00000000..5a0d30ef
--- /dev/null
+++ b/apps/web/lib/navigation/__tests__/rutas-por-experiencia-en-disco.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { join, sep } from "node:path";
+import { pantallas, type Pantalla } from "./pantallas-de-app";
+import { redireccionPorExperiencia } from "@/lib/navigation/rutas-por-experiencia";
+import { emptyPermissions } from "@/constants/permission-modules";
+
+/**
+ * SCRUM-524 · ⭐ Toda pantalla de la plataforma pasa por el bloqueo por
+ * experiencia, y lo hace en el layout de su segmento de primer nivel.
+ *
+ * El layout de `(platform)` no se vuelve a ejecutar en una navegación del
+ * cliente; el del segmento de primer nivel sí, cada vez que se entra a ese
+ * segmento. Por eso cada carpeta de `app/(platform)` tiene un `layout.tsx` con
+ * `exigirRutaDeLaExperiencia("/<su segmento>")`. Este test recorre el disco y
+ * falla si aparece una pantalla nueva sin ese layout, o con la ruta de otro
+ * segmento (un copiar y pegar que bloquearía con la regla equivocada).
+ */
+
+const APP_DIR = join(process.cwd(), "app");
+const FOUNDER = { isFounder: true, modules: emptyPermissions() };
+const GRUPO = "(platform)";
+const LLAMADA = "exigirRutaDeLaExperiencia(";
+
+const todas = pantallas(APP_DIR);
+const dePlataforma = todas.filter((p) => p.archivo.split(sep)[0] === GRUPO);
+const deAfuera = todas.filter((p) => p.archivo.split(sep)[0] !== GRUPO);
+
+function segmento(p: Pantalla): string {
+  return p.archivo.split(sep)[1]!;
+}
+
+function layoutDelSegmento(p: Pantalla): string {
+  return join(APP_DIR, GRUPO, segmento(p), "layout.tsx");
+}
+
+function llamaAlBloqueo(layout: string): boolean {
+  return readFileSync(layout, "utf8").includes(LLAMADA);
+}
+
+describe("⭐ bloqueo por experiencia en app/(platform)", () => {
+  it("el recorrido encuentra las pantallas de la plataforma, también las anidadas", () => {
+    const rutas = dePlataforma.map((p) => p.ruta);
+    expect(rutas).toContain("/finance");
+    expect(rutas).toContain("/finance/expenses");
+    expect(rutas).toContain("/team");
+    expect(rutas).toContain("/lanzamientos/[id]");
+    expect(dePlataforma.length).toBeGreaterThan(50);
+  });
+
+  it("⭐ toda pantalla cuelga del layout de su segmento, y ese layout llama al bloqueo con su propia ruta", () => {
+    const mal = dePlataforma
+      .filter((p) => {
+        const layout = layoutDelSegmento(p);
+        if (!p.layouts.includes(layout)) return true;
+        return !readFileSync(layout, "utf8").includes(`${LLAMADA}"/${segmento(p)}")`);
+      })
+      .map((p) => `${p.ruta} (app/${p.archivo})`);
+    expect(mal).toEqual([]);
+  });
+
+  it("ninguna pantalla vive suelta en la raíz de (platform) (no tendría segmento que la bloquee)", () => {
+    expect(dePlataforma.filter((p) => p.archivo.split(sep).length < 3)).toEqual([]);
+  });
+
+  it("⭐ webinar: toda pantalla fuera de Equipo y de las libres redirige a Equipo", () => {
+    const abiertas = new Set<string>();
+    for (const p of dePlataforma) {
+      const destino = redireccionPorExperiencia("webinar", p.ruta, FOUNDER);
+      if (destino === null) abiertas.add(`/${segmento(p)}`);
+      else expect(destino, p.ruta).toBe("/team");
+    }
+    expect([...abiertas].sort()).toEqual(["/holding", "/onboarding", "/settings", "/team"]);
+  });
