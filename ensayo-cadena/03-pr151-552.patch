+  ('99000000-0000-0000-0000-0000000000d1', 'dup@test',    now(), '{}'),
+  ('99000000-0000-0000-0000-0000000000d2', ' Dup@Test ',  now(), '{}'),
+  ('99000000-0000-0000-0000-0000000000f0', 'nadie@test',  now(), '{}'),
+  ('99000000-0000-0000-0000-0000000000f1', 'f@test',      now(), '{}'),
