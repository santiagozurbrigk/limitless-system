+    await expect(isStaffUser()).resolves.toBe(false);
+  });
+
+  it("un error al leer el perfil rechaza (nunca da el panel)", async () => {
+    const consola = vi.spyOn(console, "error").mockImplementation(() => {});
+    sim.errorPerfil = { message: "timeout" };
