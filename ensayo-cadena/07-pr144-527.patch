+      expect(sim.reportes).toHaveLength(1);
+      expect(todoLoRegistrado()).not.toContain(clave);
+    });
+  });
+});
diff --git a/apps/web/lib/webinar/__tests__/landing-en-integraciones.test.ts b/apps/web/lib/webinar/__tests__/landing-en-integraciones.test.ts
