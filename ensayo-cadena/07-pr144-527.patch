+        ACTIVA.id,
+        a,
+      );
+      expect(a.cerrarConfirmacion).not.toHaveBeenCalled();
+      expect(a.releer).not.toHaveBeenCalled();
+      expect(a.avisar).toHaveBeenCalledTimes(1);
+    });
