+    expect(claves.size).toBe(200);
+  });
+
+  it("devuelve el sha256 en hexadecimal de la clave entera, que no es la clave", () => {
+    const { clave, hash } = generarClaveDeIngesta();
+    expect(hash).toBe(sha256(clave));
