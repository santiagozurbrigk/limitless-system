+
+  it("el formulario avisa el primer número ilegible, con su campo y su motivo", () => {
+    expect(primerNumeroIlegible({ ...CAMPOS_VACIOS, precioDeLaOferta: "1,500" })).toEqual({
+      campo: "Precio de la oferta",
