@@ -0,0 +1,240 @@
+import Link from "next/link";
+import { AlertTriangle, CalendarClock, Users } from "lucide-react";
+import { Badge, Button, cn } from "@ai-coo/ui";
+import { EmptyState } from "@/components/shared/empty-state";
+import { CartelDatosDeEjemplo } from "@/components/webinar/cartel-datos-de-ejemplo";
+import {
+  ETIQUETA_DE_VARIANTE,
+  avisoDeRegistros,
+  formatearCantidad,
+  formatearMonto,
+  formatearTasa,
+  formatearVeces,
+  textoDelCierre,
+} from "@/lib/webinar/inicio/presentacion";
+import { RUTA_PARA_CREAR_LANZAMIENTO } from "@/lib/webinar/leads/config";
+import { urlDeLeads } from "@/lib/webinar/leads/url";
+import type {
+  FiltroDeLeads,
+  InicioDelLanzamientoActivo,
+  VistaInicio,
+} from "@/lib/webinar/vistas/contratos";
+import { ETIQUETA_DEL_ESTADO, tieneValor, type Dato } from "@/lib/webinar/vistas/dato";
+import { AvisoDeEstado } from "./aviso-de-estado";
+import { FechaDeLaOrg } from "./fecha-de-la-org";
+import { NumeroDelDato } from "./numero-del-dato";
+import { SeccionDeFuentes, SeccionDeSesiones, SeccionDelEmbudo } from "./secciones-del-lanzamiento";
+
+/**
+ * ⭐ Inicio de Limitless Webinars (SCRUM-543, A3): el lanzamiento activo con su
+ * cuenta regresiva, los números principales, lo que el equipo tiene que mover
+ * hoy, el estado de las fuentes y el aviso de registros que dejan de llegar.
+ * Dibuja lo que devuelve `leerInicio` y nada más (regla de SCRUM-542). Sin
+ * estado ni efectos: es un Server Component (las fechas, `FechaDeLaOrg`).
+ *
+ * Un número que no llegó `medido` muestra su estado y su motivo; nunca un cero
+ * inventado. Desactualizado muestra el valor con la marca y el motivo.
+ */
+export function PantallaDeInicio({
+  vista,
+  hrefCrearLanzamiento = RUTA_PARA_CREAR_LANZAMIENTO,
+  puedeVerLeads = true,
+}: {
+  vista: VistaInicio;
+  /** Si quien mira puede abrir Leads; sin acceso, el número va sin enlace. */
+  puedeVerLeads?: boolean;
+  /** Adónde lleva el estado vacío; sin ruta no hay enlace (hoy, hasta SCRUM-529). */
+  hrefCrearLanzamiento?: string | null;
+}) {
+  const { activo } = vista;
+
+  if (!tieneValor(activo)) {
+    return (
+      <div className="flex flex-col gap-4">
+        <CartelDatosDeEjemplo visible={vista.esEjemplo} />
+        <AvisoDeEstado estado={activo.state} reason={activo.reason} que="Lanzamiento activo" />
+      </div>
+    );
+  }
+
+  if (activo.value === null) {
+    return (
+      <div className="flex flex-col gap-4">
+        <CartelDatosDeEjemplo visible={vista.esEjemplo} />
+        <EmptyState
+          title="No hay un lanzamiento activo."
+          description="Cuando actives uno, acá vas a ver sus registros, ventas y lo que el equipo tiene que mover hoy."
+          action={
+            hrefCrearLanzamiento ? (
+              <Button asChild size="sm">
+                <Link href={hrefCrearLanzamiento}>Crear un lanzamiento</Link>
+              </Button>
+            ) : undefined
+          }
+        />
+      </div>
+    );
+  }
+
+  const inicio = activo.value;
+  return (
+    <div className="flex flex-col gap-6">
+      <CartelDatosDeEjemplo visible={vista.esEjemplo} />
+      {activo.state === "desactualizado" ? (
+        <AvisoDeEstado estado={activo.state} reason={activo.reason} que="Lanzamiento activo" />
+      ) : null}
+      <Encabezado inicio={inicio} />
+      <AvisoDeRegistrosQueNoLlegan inicio={inicio} />
+      <NumerosPrincipales inicio={inicio} />
+      <ActividadDeHoy inicio={inicio} puedeVerLeads={puedeVerLeads} />
+      <SeccionDelEmbudo embudo={inicio.embudo} />
+      <SeccionDeSesiones sesiones={inicio.sesiones} />
+      <SeccionDeFuentes fuentes={inicio.fuentes} />
+    </div>
+  );
+}
+
+function Encabezado({ inicio }: { inicio: InicioDelLanzamientoActivo }) {
+  const { lanzamiento } = inicio;
+  const cierreVencido = inicio.diasParaElCierre !== null && inicio.diasParaElCierre < 0;
+  return (
+    <section aria-label="Lanzamiento activo" className="flex flex-col gap-3 rounded-xl border border-border p-4">
+      <div className="flex flex-wrap items-center gap-2">
+        <h2 className="text-lg font-semibold">{lanzamiento.nombre}</h2>
+        <Badge variant="outline">{ETIQUETA_DE_VARIANTE[lanzamiento.variante]}</Badge>
+        {lanzamiento.precioDeLaOferta !== null ? (
+          <span className="text-sm text-muted-foreground">
+            Oferta: {formatearMonto(lanzamiento.precioDeLaOferta, lanzamiento.moneda)}
+          </span>
+        ) : null}
+      </div>
+      <div className="flex flex-wrap items-baseline gap-x-6 gap-y-2">
+        <p
+          data-cuenta-regresiva
+          className={cn("text-2xl font-semibold", cierreVencido ? "text-warning" : "text-primary")}
+        >
+          {textoDelCierre(inicio.diasParaElCierre)}
+        </p>
+        <p className="flex items-center gap-1.5 text-sm text-muted-foreground">
+          <CalendarClock className="h-4 w-4" aria-hidden="true" />
+          {inicio.proximaSesion ? (
+            <>
+              Próxima sesión: <FechaDeLaOrg iso={inicio.proximaSesion.empiezaAt} />
+            </>
+          ) : (
+            "No hay sesiones por delante"
+          )}
+        </p>
+      </div>
+    </section>
+  );
+}
+
+function AvisoDeRegistrosQueNoLlegan({ inicio }: { inicio: InicioDelLanzamientoActivo }) {
+  const aviso = avisoDeRegistros(inicio);
+  if (!aviso) return null;
+  return (
+    <div
+      role="alert"
+      data-aviso="registros"
+      className="flex items-start gap-2 rounded-lg border border-warning/40 px-4 py-3 text-sm"
+    >
+      <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0 text-warning" aria-hidden="true" />
+      <div>
+        <p className="font-medium">{aviso.titulo}</p>
+        <p className="text-muted-foreground">{aviso.detalle}</p>
+      </div>
+    </div>
+  );
+}
+
+function NumerosPrincipales({ inicio }: { inicio: InicioDelLanzamientoActivo }) {
+  const moneda = inicio.lanzamiento.moneda;
+  const monto = (valor: number) => formatearMonto(valor, moneda);
+  const recientes = inicio.registradosUltimas24h;
+  return (
+    <section aria-label="Números principales" className="flex flex-col gap-3">
+      <h3 className="text-sm font-medium">Números principales</h3>
+      <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
+        <NumeroDelDato
+          etiqueta="Registrados"
+          dato={inicio.registrados}
+          formatear={formatearCantidad}
+          ayuda={tieneValor(recientes) ? `+${formatearCantidad(recientes.value)} en las últimas 24 h` : null}
+        />
+        <NumeroDelDato etiqueta="Asistencia" dato={inicio.tasas.asistencia} formatear={formatearTasa} />
+        <NumeroDelDato etiqueta="Ventas" dato={inicio.ventas.ventas} formatear={formatearCantidad} />
+        <NumeroDelDato etiqueta="Ingresos" dato={inicio.ventas.ingresos} formatear={monto} />
+        <NumeroDelDato
+          etiqueta="Conversión de asistentes"
+          dato={inicio.tasas.conversionDeAsistentes}
+          formatear={formatearTasa}
+        />
+        {inicio.ventas.ventasVip ? (
+          <NumeroDelDato etiqueta="Ventas VIP" dato={inicio.ventas.ventasVip} formatear={formatearCantidad} />
+        ) : null}
+        {inicio.anuncios ? (
+          <>
+            <NumeroDelDato etiqueta="Inversión en anuncios" dato={inicio.anuncios.inversion} formatear={monto} />
+            <NumeroDelDato
+              etiqueta="Costo por registro"
+              dato={inicio.anuncios.costoPorRegistro}
+              formatear={(v) => (v === null ? "—" : monto(v))}
+            />
+            <NumeroDelDato etiqueta="ROAS" dato={inicio.anuncios.roas} formatear={formatearVeces} />
+          </>
+        ) : null}
+      </div>
+    </section>
+  );
+}
+
+function ActividadDeHoy({ inicio, puedeVerLeads }: { inicio: InicioDelLanzamientoActivo; puedeVerLeads: boolean }) {
+  const launchId = inicio.lanzamiento.id;
+  const pendientes: { etiqueta: string; dato: Dato<number>; filtro: FiltroDeLeads }[] = [
+    {
+      etiqueta: "Levantaron la mano y nadie los contactó",
+      dato: inicio.pendientesDelEquipo.levantaronLaManoSinContactar,
+      filtro: "levanto_la_mano_sin_contactar",
+    },
+    {
+      etiqueta: "Agendaron una llamada y no cerraron",
+      dato: inicio.pendientesDelEquipo.agendadosSinCerrar,
+      filtro: "agendado_sin_cerrar",
+    },
+  ];
+  return (
+    <section aria-label="Actividad de hoy" className="flex flex-col gap-3">
+      <h3 className="flex items-center gap-1.5 text-sm font-medium">
+        <Users className="h-4 w-4" aria-hidden="true" />
+        Lo que el equipo tiene que mover hoy
+      </h3>
+      <ul className="flex flex-col gap-2">
+        {pendientes.map((p) => (
+          <li
+            key={p.filtro}
+            data-pendiente={p.filtro}
+            className="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-border px-3 py-2 text-sm"
+          >
+            <span>{p.etiqueta}</span>
+            {tieneValor(p.dato) && !puedeVerLeads ? (
+              <span className="font-semibold tabular-nums">{formatearCantidad(p.dato.value)}</span>
+            ) : tieneValor(p.dato) ? (
+              <Link
+                href={urlDeLeads({ filtro: p.filtro, launchId })}
+                className="font-semibold tabular-nums text-primary hover:underline"
+              >
+                {formatearCantidad(p.dato.value)} · Ver leads
+              </Link>
+            ) : (
+              <span className="text-xs text-muted-foreground">
+                {ETIQUETA_DEL_ESTADO[p.dato.state]}. {p.dato.reason}
+              </span>
+            )}
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
diff --git a/apps/web/components/webinar/pantalla-de-lanzamientos.tsx b/apps/web/components/webinar/pantalla-de-lanzamientos.tsx
new file mode 100644
index 00000000..2c1951bd
--- /dev/null
+++ b/apps/web/components/webinar/pantalla-de-lanzamientos.tsx
@@ -0,0 +1,148 @@
+import Link from "next/link";
+import { Badge, Button } from "@ai-coo/ui";
+import { EmptyState } from "@/components/shared/empty-state";
+import { CartelDatosDeEjemplo } from "@/components/webinar/cartel-datos-de-ejemplo";
+import {
+  ETIQUETA_DE_VARIANTE,
+  formatearCantidad,
+  formatearMonto,
+} from "@/lib/webinar/inicio/presentacion";
+import { RUTA_PARA_CREAR_LANZAMIENTO } from "@/lib/webinar/leads/config";
+import {
+  ETIQUETA_DEL_ESTADO_DEL_LANZAMIENTO,
+  textoDeLasFechas,
+} from "@/lib/webinar/lanzamientos/presentacion";
+import type { VistaListaDeLanzamientos } from "@/lib/webinar/vistas/contratos";
+import {
+  ETIQUETA_DEL_ESTADO,
+  tieneValor,
+  type Dato,
+} from "@/lib/webinar/vistas/dato";
+import { paths } from "@/routes/paths";
+import { AvisoDeEstado } from "./aviso-de-estado";
+
+/**
+ * ⭐ Lista de lanzamientos de Limitless Webinars (SCRUM-544): cada uno con su
+ * variante, estado, fechas, registrados, asistentes, ventas e ingresos, y el
+ * enlace a su detalle. Dibuja lo que devuelve `leerListaDeLanzamientos` y
+ * nada más; el orden (activos primero) viene del contrato. Crear y editar es
+ * de SCRUM-529.
+ */
+export function PantallaDeLanzamientos({
+  vista,
+  hrefCrearLanzamiento = RUTA_PARA_CREAR_LANZAMIENTO,
+}: {
+  vista: VistaListaDeLanzamientos;
+  hrefCrearLanzamiento?: string | null;
+}) {
+  const { lanzamientos } = vista;
+  return (
+    <div className="flex flex-col gap-4">
+      <CartelDatosDeEjemplo visible={vista.esEjemplo} />
+      {!tieneValor(lanzamientos) ? (
+        <AvisoDeEstado
+          estado={lanzamientos.state}
+          reason={lanzamientos.reason}
+          que="Lanzamientos"
+        />
+      ) : lanzamientos.value.length === 0 ? (
+        <EmptyState
+          title="Todavía no hay lanzamientos."
+          description="Cuando crees uno, vas a ver acá sus registros, asistentes y ventas."
+          action={
+            hrefCrearLanzamiento ? (
+              <Button asChild size="sm">
+                <Link href={hrefCrearLanzamiento}>Crear un lanzamiento</Link>
+              </Button>
+            ) : undefined
+          }
+        />
+      ) : (
+        <>
+          {hrefCrearLanzamiento ? (
+            <Button asChild size="sm" className="self-start">
+              <Link href={hrefCrearLanzamiento}>Crear un lanzamiento</Link>
+            </Button>
+          ) : null}
+          <ul className="flex flex-col gap-3">
+            {lanzamientos.value.map((fila) => {
+              const l = fila.lanzamiento;
+              return (
+                <li key={l.id} data-lanzamiento={l.id}>
+                  <Link
+                    href={paths.platform.lanzamientosDetail(l.id)}
+                    className="flex flex-col gap-3 rounded-xl border border-border p-4 transition-colors hover:border-primary/40"
+                  >
+                    <div className="flex flex-wrap items-center gap-2">
+                      <span className="font-semibold">{l.nombre}</span>
+                      <Badge variant="outline">
+                        {ETIQUETA_DE_VARIANTE[l.variante]}
+                      </Badge>
+                      <Badge
+                        variant={
+                          l.estado === "active" ? "default" : "secondary"
+                        }
+                      >
+                        {ETIQUETA_DEL_ESTADO_DEL_LANZAMIENTO[l.estado]}
+                      </Badge>
+                      <span className="text-xs text-muted-foreground">
+                        {textoDeLasFechas(l.captaDesde, l.cierraEl)}
+                      </span>
+                    </div>
+                    <dl className="grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
+                      <Celda
+                        etiqueta="Registrados"
+                        dato={fila.registrados}
+                        formatear={formatearCantidad}
+                      />
+                      <Celda
+                        etiqueta="Asistieron"
+                        dato={fila.asistieron}
+                        formatear={formatearCantidad}
+                      />
+                      <Celda
+                        etiqueta="Ventas"
+                        dato={fila.ventas}
+                        formatear={formatearCantidad}
+                      />
+                      <Celda
+                        etiqueta="Ingresos"
+                        dato={fila.ingresos}
+                        formatear={(v) => formatearMonto(v, l.moneda)}
+                      />
+                    </dl>
+                  </Link>
+                </li>
+              );
+            })}
+          </ul>
+        </>
+      )}
+    </div>
+  );
+}
+
+function Celda({
+  etiqueta,
+  dato,
+  formatear,
+}: {
+  etiqueta: string;
+  dato: Dato<number>;
+  formatear: (v: number) => string;
+}) {
+  return (
+    <div
+      data-celda={etiqueta}
+      data-estado={dato.state}
+      className="flex flex-col"
+    >
+      <dt className="text-xs text-muted-foreground">{etiqueta}</dt>
+      <dd className="font-medium tabular-nums" title={dato.reason ?? undefined}>
+        {tieneValor(dato)
+          ? formatear(dato.value)
+          : ETIQUETA_DEL_ESTADO[dato.state]}
+      </dd>
+    </div>
+  );
+}
diff --git a/apps/web/components/webinar/secciones-del-lanzamiento.tsx b/apps/web/components/webinar/secciones-del-lanzamiento.tsx
new file mode 100644
index 00000000..51ed699c
--- /dev/null
+++ b/apps/web/components/webinar/secciones-del-lanzamiento.tsx
@@ -0,0 +1,172 @@
+import { Plug } from "lucide-react";
+import { cn } from "@ai-coo/ui";
+import {
+  formatearCantidad,
+  formatearTasa,
+  fuentesConProblemas,
+  fuentesOrdenadas,
+} from "@/lib/webinar/inicio/presentacion";
+import type {
+  EstadoDeFuente,
+  PasoDelEmbudo,
+  PasoDelEmbudoId,
+  SesionDelLanzamiento,
+} from "@/lib/webinar/vistas/contratos";
+import { ETIQUETA_DE_FUENTE, ETIQUETA_DEL_ESTADO, tieneValor, type Dato } from "@/lib/webinar/vistas/dato";
+import { FechaDeLaOrg } from "./fecha-de-la-org";
+import { AccionDelDato } from "./numero-del-dato";
+
+/**
+ * Secciones que comparten Inicio (SCRUM-543) y el Detalle del lanzamiento
+ * (SCRUM-544): sesiones, estado de las fuentes y el embudo. Dibujan sólo el
+ * contrato; sin estado ni efectos.
+ */
+
+/** Un número en una línea de texto: el valor o el estado en minúscula. */
+function textoCorto(dato: Dato<number>): string {
+  return tieneValor(dato) ? formatearCantidad(dato.value) : ETIQUETA_DEL_ESTADO[dato.state].toLowerCase();
+}
+
+export function SeccionDeSesiones({ sesiones }: { sesiones: readonly SesionDelLanzamiento[] }) {
+  return (
+    <section aria-label="Sesiones" className="flex flex-col gap-2">
+      <h3 className="text-sm font-medium">Sesiones</h3>
+      {sesiones.length === 0 ? (
+        <p className="text-sm text-muted-foreground">Este lanzamiento todavía no tiene sesiones cargadas.</p>
+      ) : (
+        <ul className="flex flex-col gap-2 text-sm">
+          {sesiones.map((sesion) => (
+            <li key={sesion.id} data-sesion={sesion.id} className="rounded-lg border border-border px-3 py-2">
+              <p className="font-medium">
+                <FechaDeLaOrg iso={sesion.empiezaAt} />
+              </p>
+              {sesion.asistieron === null ? (
+                <p className="text-xs text-muted-foreground">Todavía no ocurrió.</p>
+              ) : (
+                <p className="text-xs text-muted-foreground">
+                  Asistieron: {textoCorto(sesion.asistieron)} · Se quedaron a la oferta:{" "}
+                  {sesion.seQuedaronALaOferta ? textoCorto(sesion.seQuedaronALaOferta) : "—"}
+                </p>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
+
+export function SeccionDeFuentes({ fuentes }: { fuentes: readonly EstadoDeFuente[] }) {
+  const problemas = fuentesConProblemas(fuentes);
+  return (
+    <section aria-label="Estado de las fuentes" className="flex flex-col gap-2">
+      <h3 className="flex items-center gap-1.5 text-sm font-medium">
+        <Plug className="h-4 w-4" aria-hidden="true" />
+        Estado de las fuentes
+        <span className="font-normal text-muted-foreground">
+          {problemas === 0
+            ? "· todas al día"
+            : problemas === 1
+              ? "· 1 no está al día"
+              : `· ${problemas} no están al día`}
+        </span>
+      </h3>
+      <ul className="flex flex-col gap-2 text-sm">
+        {fuentesOrdenadas(fuentes).map((fuente) => (
+          <li
+            key={fuente.fuente}
+            data-fuente={fuente.fuente}
+            data-estado={fuente.state}
+            className={cn(
+              "flex flex-col gap-0.5 rounded-lg border px-3 py-2",
+              fuente.state === "error" ? "border-destructive/40" : "border-border"
+            )}
+          >
+            <p className="flex flex-wrap items-center gap-2">
+              <span className="font-medium">{ETIQUETA_DE_FUENTE[fuente.fuente]}</span>
+              <span
+                className={cn(
+                  "text-xs",
+                  fuente.state === "medido" ? "text-muted-foreground" : "text-warning",
+                  fuente.state === "error" && "text-destructive"
+                )}
+              >
+                {fuente.state === "medido" ? "Al día" : ETIQUETA_DEL_ESTADO[fuente.state]}
+              </span>
+            </p>
+            {fuente.reason ? <p className="text-xs text-muted-foreground">{fuente.reason}</p> : null}
+            {fuente.ultimaLecturaAt ? (
+              <p className="text-xs text-muted-foreground">
+                Última lectura: <FechaDeLaOrg iso={fuente.ultimaLecturaAt} />
+              </p>
+            ) : null}
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+/**
+ * El embudo. En Inicio, compacto (etapa y personas). En el Detalle
+ * (`completo`), con el paso desde la etapa base, la fuente de cada número y la
+ * acción de su estado.
+ */
+export function SeccionDelEmbudo({
+  embudo,
+  completo = false,
+  launchId,
+}: {
+  embudo: readonly PasoDelEmbudo[];
+  completo?: boolean;
+  launchId?: string;
+}) {
+  const etiquetaDe = new Map<PasoDelEmbudoId, string>(embudo.map((p) => [p.paso, p.etiqueta]));
+  return (
+    <section aria-label="Embudo" className="flex flex-col gap-3">
+      <h3 className="text-sm font-medium">Embudo</h3>
+      <ol className="flex flex-col gap-1.5 text-sm">
+        {embudo.map((paso) => (
+          <li
+            key={paso.paso}
+            data-paso={paso.paso}
+            data-estado={paso.personas.state}
+            className="flex flex-wrap items-start justify-between gap-x-3 gap-y-1 border-b border-border/60 py-1.5 last:border-b-0"
+          >
+            <div className="flex flex-col">
+              <span>{paso.etiqueta}</span>
+              {completo ? (
+                <span className="text-xs text-muted-foreground">
+                  Fuente: {ETIQUETA_DE_FUENTE[paso.personas.source]}
+                </span>
+              ) : null}
+            </div>
+            <div className="flex flex-col items-end gap-0.5 text-right">
+              {tieneValor(paso.personas) ? (
+                <span className="font-medium tabular-nums">
+                  {formatearCantidad(paso.personas.value)}
+                  {paso.personas.state === "desactualizado" ? (
+                    <span className="ml-1 text-xs text-warning">({ETIQUETA_DEL_ESTADO.desactualizado})</span>
+                  ) : null}
+                </span>
+              ) : (
+                <span className="text-xs text-muted-foreground" title={paso.personas.reason}>
+                  {ETIQUETA_DEL_ESTADO[paso.personas.state]}
+                  {completo ? `. ${paso.personas.reason}` : ""}
+                </span>
+              )}
+              {completo && paso.pasoDesde ? (
+                <span data-paso-desde={paso.pasoDesde.desde} className="text-xs text-muted-foreground">
+                  {tieneValor(paso.pasoDesde.tasa)
+                    ? `${formatearTasa(paso.pasoDesde.tasa.value)} de «${etiquetaDe.get(paso.pasoDesde.desde) ?? paso.pasoDesde.desde}»`
+                    : `Paso: ${ETIQUETA_DEL_ESTADO[paso.pasoDesde.tasa.state].toLowerCase()}`}
+                </span>
+              ) : null}
+              {completo && launchId ? <AccionDelDato dato={paso.personas} launchId={launchId} /> : null}
+            </div>
+          </li>
+        ))}
+      </ol>
+    </section>
+  );
+}
diff --git a/apps/web/lib/administracion/__tests__/consola.test.ts b/apps/web/lib/administracion/__tests__/consola.test.ts
new file mode 100644
index 00000000..3e85e524
--- /dev/null
+++ b/apps/web/lib/administracion/__tests__/consola.test.ts
@@ -0,0 +1,101 @@
+/**
+ * SCRUM-551 · La consola de Administración dentro de la org de Limitless:
+ * sólo el staff la ve en el menú, sus enlaces no sacan al panel viejo y cada
+ * pantalla usa los componentes del super-admin con `base="consola"`.
+ */
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative } from "node:path";
+import { describe, expect, it } from "vitest";
+import { emptyPermissions } from "@/constants/permission-modules";
+import { itemsDeLaPaleta } from "@/components/navigation/command-palette";
+import { buildPlatformSidebarNav } from "@/lib/navigation/sidebar-modules";
+import { paths } from "@/routes/paths";
+import { rutasDeAdministracion } from "../rutas";
+
+const FOUNDER = { isFounder: true, modules: emptyPermissions() };
+const CONSOLA = join(__dirname, "..", "..", "..", "app", "(platform)", "administracion");
+
+describe("⭐ el menú limitless", () => {
+  it("con esStaff, la barra tiene el grupo Administración con sus cinco pantallas", () => {
+    const barra = buildPlatformSidebarNav([], "limitless", true);
+    expect(barra.rootItems).toContainEqual({ type: "parent", key: "administracion" });
+    expect(barra.modulesWithChildren.administracion.children.map((c) => c.label)).toEqual([
+      "Organizaciones",
+      "Usuarios",
+      "Holdings",
+      "Sistema",
+      "Onboarding",
+    ]);
+    expect(barra.getParentFromPath(paths.platform.consola.usuarios)).toBe("administracion");
+  });
+
+  it("⭐ sin esStaff (aunque sea founder), no hay Administración en la barra ni en la paleta", () => {
+    const barra = buildPlatformSidebarNav([], "limitless", false);
+    expect(barra.rootItems).not.toContainEqual({ type: "parent", key: "administracion" });
+    expect(barra.modulesWithChildren.administracion).toBeUndefined();
+    expect(itemsDeLaPaleta("limitless", FOUNDER).map((i) => i.group)).not.toContain("Administración");
+  });
+
+  it("la paleta del staff lista las pantallas de Administración", () => {
+    const items = itemsDeLaPaleta("limitless", { ...FOUNDER, esStaff: true }).filter((i) => i.group === "Administración");
+    expect(items.map((i) => i.href)).toEqual([
+      paths.platform.consola.organizaciones,
+      paths.platform.consola.usuarios,
+      paths.platform.consola.holdings,
+      paths.platform.consola.sistema,
+      paths.platform.consola.onboarding,
+    ]);
+  });
+
+  it("el menú completo y el webinar no tienen Administración, ni siquiera para el staff", () => {
+    expect(buildPlatformSidebarNav([], "full", true).rootItems).not.toContainEqual({ type: "parent", key: "administracion" });
+    expect(buildPlatformSidebarNav([], "webinar", true).rootItems).not.toContainEqual({ type: "parent", key: "administracion" });
+  });
+});
+
+describe("rutasDeAdministracion", () => {
+  it("sin base, el panel viejo como siempre; con «consola», todo bajo /administracion", () => {
+    expect(rutasDeAdministracion().organizacion("x")).toBe(paths.superAdmin.organizationDetail("x"));
+    const consola = rutasDeAdministracion("consola");
+    for (const valor of [
+      consola.organizaciones,
+      consola.organizacion("x"),
+      consola.organizacionNueva,
+      consola.usuarios,
+      consola.holdings,
+      consola.sistema,
+      consola.onboarding,
+    ]) {
+      expect(valor.startsWith(`${paths.platform.administracion}/`), valor).toBe(true);
+    }
+  });
+});
+
+function paginas(dir: string): string[] {
+  return readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const ruta = join(dir, e.name);
+    if (e.isDirectory()) return e.name === "__tests__" ? [] : paginas(ruta);
+    return e.name === "page.tsx" ? [ruta] : [];
+  });
+}
+
+describe("⭐ las pantallas de la consola", () => {
+  const COMPONENTES_CON_ENLACES =
+    /<(OrganizationsList|OrganizationDetailView|CreateFounderForm|UsersTable|HoldingsAdminPanel|HoldingPortfolioContent|OnboardingDeClientes)\b[^>]*>/g;
+
+  it.each(paginas(CONSOLA).map((p) => [relative(CONSOLA, p), p]))(
+    "%s: cada componente con enlaces recibe base=\"consola\"",
+    (_ruta, archivo) => {
+      const codigo = readFileSync(archivo, "utf8");
+      for (const [etiqueta] of codigo.matchAll(COMPONENTES_CON_ENLACES)) {
+        expect(etiqueta).toContain('base="consola"');
+      }
+    }
+  );
+
+  it("el layout exige la experiencia y la lista de staff", () => {
+    const layout = readFileSync(join(CONSOLA, "layout.tsx"), "utf8");
+    expect(layout).toContain('exigirRutaDeLaExperiencia("/administracion")');
+    expect(layout).toMatch(/if \(!\(await isStaffUser\(\)\)\) redirect\(/);
+  });
+});
diff --git a/apps/web/lib/administracion/__tests__/experiencia.test.ts b/apps/web/lib/administracion/__tests__/experiencia.test.ts
