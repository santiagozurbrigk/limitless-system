+
+describe("urlDeLaFicha", () => {
+  it("con lanzamiento, lo lleva en ?lanzamiento=", () => {
+    expect(urlDeLaFicha(LEAD, LANZAMIENTO)).toBe(`/leads/${LEAD}?lanzamiento=${LANZAMIENTO}`);
+  });
+
+  it("sin lanzamiento, la ficha a secas", () => {
