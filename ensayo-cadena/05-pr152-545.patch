@@ -0,0 +1,73 @@
+import Link from "next/link";
+import { cn } from "@ai-coo/ui";
+import { urlDeLeads } from "@/lib/webinar/leads/url";
+import type {
+  ConteoDeFiltro,
+  FiltroDeLeads,
+  ParametrosDeLeads,
+} from "@/lib/webinar/vistas/contratos";
+import { ETIQUETA_DEL_ESTADO, tieneValor } from "@/lib/webinar/vistas/dato";
+import { AvisoDeEstado } from "./aviso-de-estado";
+
+/**
+ * Los filtros de trabajo de Leads con su conteo (SCRUM-545, AC-2, AC-3). Son
+ * enlaces: el filtro vive en la URL, elegir uno navega sin recargar la
+ * pantalla a mano y la URL se puede compartir (DT-16). Cambiar de filtro vuelve
+ * a la primera página. Sin estado ni efectos.
+ *
+ * Un conteo que no llegó `medido` no muestra un número: muestra su estado, y
+ * abajo el motivo (AC-4, CD-4).
+ */
+export function FiltrosDeLeads({
+  filtros,
+  filtroElegido,
+  actual,
+}: {
+  filtros: ConteoDeFiltro[];
+  filtroElegido: FiltroDeLeads;
+  /** Los parámetros de la URL de hoy (para conservar búsqueda y lanzamiento). */
+  actual: ParametrosDeLeads;
+}) {
+  const sinMedir = filtros.filter((f) => f.personas.state !== "medido");
+  const motivos = new Map<string, (typeof sinMedir)[number]["personas"]>();
+  for (const f of sinMedir) motivos.set(`${f.personas.state}|${f.personas.reason}`, f.personas);
+
+  return (
+    <div className="flex flex-col gap-2">
+      <nav aria-label="Filtros de leads" className="flex flex-wrap gap-1.5">
+        {filtros.map((conteo) => {
+          const activo = conteo.filtro === filtroElegido;
+          return (
+            <Link
+              key={conteo.filtro}
+              href={urlDeLeads(actual, { filtro: conteo.filtro })}
+              aria-current={activo ? "page" : undefined}
+              data-filtro={conteo.filtro}
+              className={cn(
+                "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs transition-colors",
+                activo
+                  ? "border-primary bg-primary/10 text-primary"
+                  : "border-border text-muted-foreground hover:border-primary/40"
+              )}
+            >
+              <span>{conteo.etiqueta}</span>
+              <span className="font-medium" data-conteo={conteo.personas.state}>
+                {tieneValor(conteo.personas)
+                  ? conteo.personas.value
+                  : ETIQUETA_DEL_ESTADO[conteo.personas.state]}
+              </span>
+            </Link>
+          );
+        })}
+      </nav>
+      {[...motivos.values()].map((dato) => (
+        <AvisoDeEstado
+          key={`${dato.state}|${dato.reason}`}
+          estado={dato.state}
+          reason={dato.reason}
+          que="Conteos de los filtros"
+        />
+      ))}
+    </div>
+  );
+}
diff --git a/apps/web/components/webinar/panel-de-venta-cliente.tsx b/apps/web/components/webinar/panel-de-venta-cliente.tsx
new file mode 100644
index 00000000..368a2cfd
--- /dev/null
+++ b/apps/web/components/webinar/panel-de-venta-cliente.tsx
@@ -0,0 +1,112 @@
+"use client";
+
+import { useState, useTransition } from "react";
+import {
+  agregarNotaDelLeadAction,
+  asignarResponsableDelLeadAction,
+  marcarAvanceDelLeadAction,
+} from "@/app/leads/actions";
+import { correrMutacion } from "@/lib/client/correr-accion";
+import {
+  agregarNotaLocal,
+  aplicarAvance,
+  aplicarResponsable,
+  estadoInicial,
+  type EstadoLocalDelLead,
+} from "@/lib/webinar/leads/estado-local";
+import type {
+  EstadoDeVenta,
+  EtapaDelLead,
+  NotaDelLead,
+  PersonaDelEquipo,
+} from "@/lib/webinar/vistas/contratos";
+import { tieneValor, type Dato } from "@/lib/webinar/vistas/dato";
+import { useToast } from "@/providers/toast-provider";
+import { PanelDeVentaDelLead } from "./panel-de-venta-del-lead";
+
+/**
+ * El envoltorio cliente del panel de venta (SCRUM-545, DT-11): guarda el
+ * cambio de ejemplo en el estado local y llama a las acciones simuladas. Con
+ * éxito aplica el cambio sólo acá (se pierde al recargar); con error,
+ * `correrMutacion` avisa con el motivo y no cambia nada.
+ *
+ * La ficha lo dibuja con `key` de lead y lanzamiento: al pasar a otra ficha
+ * no arrastra el estado.
+ */
+export function PanelDeVentaCliente({
+  leadId,
+  launchId,
+  estadoDeVenta,
+  notas,
+  equipo,
+}: {
+  leadId: string;
+  launchId: string;
+  estadoDeVenta: Dato<EstadoDeVenta>;
+  notas: Dato<NotaDelLead[]>;
+  equipo: PersonaDelEquipo[];
+}) {
+  const [local, setLocal] = useState<EstadoLocalDelLead | null>(() =>
+    tieneValor(estadoDeVenta) ? estadoInicial(estadoDeVenta.value) : null
+  );
+  const [borrador, setBorrador] = useState("");
+  const [ocupado, startTransition] = useTransition();
+  const { push } = useToast();
+
+  function marcarAvance(etapaActual: EtapaDelLead) {
+    startTransition(() =>
+      correrMutacion({
+        accion: () => marcarAvanceDelLeadAction({ leadId, launchId, etapaActual }),
+        avisar: push,
+        tituloError: "No se pudo marcar el avance",
+        etiqueta: "[PanelDeVentaCliente] marcar avance",
+        alExito: ({ etapa }) => setLocal((previo) => (previo ? aplicarAvance(previo, etapa) : previo)),
+      })
+    );
+  }
+
+  function asignarResponsable(responsableUserId: string | null) {
+    startTransition(() =>
+      correrMutacion({
+        accion: () => asignarResponsableDelLeadAction({ leadId, launchId, responsableUserId }),
+        avisar: push,
+        tituloError: "No se pudo asignar el responsable",
+        etiqueta: "[PanelDeVentaCliente] asignar responsable",
+        alExito: (data) => {
+          const persona = equipo.find((p) => p.userId === data.responsableUserId) ?? null;
+          setLocal((previo) => (previo ? aplicarResponsable(previo, persona) : previo));
+        },
+      })
+    );
+  }
+
+  function agregarNota() {
+    startTransition(() =>
+      correrMutacion({
+        accion: () => agregarNotaDelLeadAction({ leadId, launchId, texto: borrador }),
+        avisar: push,
+        tituloError: "No se pudo agregar la nota",
+        etiqueta: "[PanelDeVentaCliente] agregar nota",
+        alExito: ({ texto, creadaAt }) => {
+          setLocal((previo) => (previo ? agregarNotaLocal(previo, { launchId, texto, creadaAt }) : previo));
+          setBorrador("");
+        },
+      })
+    );
+  }
+
+  return (
+    <PanelDeVentaDelLead
+      estadoDeVenta={estadoDeVenta}
+      notas={notas}
+      equipo={equipo}
+      local={local}
+      borradorDeNota={borrador}
+      ocupado={ocupado}
+      alMarcarAvance={marcarAvance}
+      alAsignarResponsable={asignarResponsable}
+      alCambiarBorrador={setBorrador}
+      alAgregarNota={agregarNota}
+    />
+  );
+}
diff --git a/apps/web/components/webinar/panel-de-venta-del-lead.tsx b/apps/web/components/webinar/panel-de-venta-del-lead.tsx
