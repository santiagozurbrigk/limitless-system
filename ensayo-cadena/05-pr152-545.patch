+    ).toEqual({ success: true, data: { responsableUserId: SETTER } });
+    expect(
+      await asignarResponsableDelLeadAction({ leadId: LEAD, launchId: LANZAMIENTO, responsableUserId: null })
+    ).toEqual({ success: true, data: { responsableUserId: null } });
