+    ).toEqual({ success: false, error: SIN_ORGANIZACION_VINCULADA });
+    expect(await agregarNotaDelLeadAction({ leadId: "x", launchId: "x", texto: "" })).toEqual({
+      success: false,
+      error: SIN_ORGANIZACION_VINCULADA,
